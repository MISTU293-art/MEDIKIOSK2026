<%- include('../partials/header') %>
<div class="app-layout-wrapper"><%- include('../partials/sidebar') %><div class="main-content-wrapper"><%- include('../partials/topbar') %>
<main class="p-4">
  <h2 class="fw-bold">Live Bed Board</h2>
  <p class="text-muted">Hospital capacity, allocation, turnover, and current bed status.</p>
  <% if (user && user.role === 'admin') { %>
  <div class="card border-0 shadow-sm p-4 mb-3"><h5>Configure hospital capacity</h5><div class="row g-3">
    <form id="wardForm" class="col-lg-5 row g-2"><div class="col-sm-5"><input name="name" class="form-control" placeholder="Ward name" required></div><div class="col-sm-5"><input name="department" class="form-control" placeholder="Department"></div><div class="col-sm-2"><button class="btn btn-outline-primary w-100" type="submit">Add</button></div></form>
    <form id="bedForm" class="col-lg-7 row g-2"><div class="col-sm-4"><select name="wardId" class="form-select" required><option value="">Select ward</option><% wards.forEach(ward => { %><option value="<%= ward._id %>"><%= ward.name %></option><% }) %></select></div><div class="col-sm-3"><input name="bedNumber" class="form-control" placeholder="Bed number" required></div><div class="col-sm-3"><select name="bedType" class="form-select"><option>General</option><option>ICU</option><option>Emergency</option><option>Maternity</option></select></div><div class="col-sm-2"><button class="btn btn-primary w-100" type="submit">Add bed</button></div></form>
  </div><div id="capacityFeedback" class="small mt-2" role="alert"></div></div>
  <% } %>
  <% const availableBeds = beds.filter(bed => bed.status === 'available'); if (availableBeds.length && patients.length) { %>
  <div class="card border-0 shadow-sm p-4 mb-3"><h5>Allocate available bed</h5><form id="allocateForm" class="row g-2"><div class="col-md-5"><select name="bedId" class="form-select" required><option value="">Select bed</option><% availableBeds.forEach(bed => { %><option value="<%= bed._id %>"><%= bed.bedNumber %></option><% }) %></select></div><div class="col-md-5"><select name="patientId" class="form-select" required><option value="">Select active visit</option><% patients.forEach(patient => { %><option value="<%= patient._id %>"><%= patient.fullName %> · <%= patient.cardNumber || patient.uhid %></option><% }) %></select></div><div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Assign</button></div></form></div>
  <% } %>
  <div class="row g-3"><% wards.forEach(ward => { const wardBeds = beds.filter(bed => bed.wardId === String(ward._id)); %><div class="col-12"><div class="card border-0 shadow-sm p-4"><div class="d-flex justify-content-between"><h5><%= ward.name %> <small class="text-muted"><%= ward.department || '' %></small></h5><span class="badge bg-light text-dark border"><%= wardBeds.filter(bed => bed.status === 'occupied').length %> / <%= wardBeds.length %> occupied</span></div><div class="row g-2"><% wardBeds.forEach(bed => { %><div class="col-6 col-md-3"><div class="border rounded p-3"><strong><%= bed.bedNumber %></strong><div class="small text-muted"><%= bed.bedType %></div><span class="badge d-block my-2 bg-<%= bed.status === 'available' ? 'success' : bed.status === 'occupied' ? 'danger' : 'warning text-dark' %>"><%= bed.status %></span><% if (bed.status === 'occupied') { %><button class="btn btn-sm btn-outline-danger w-100 bed-action" data-action="release" data-id="<%= bed._id %>">Release to cleaning</button><% } else if (bed.status === 'cleaning') { %><button class="btn btn-sm btn-outline-success w-100 bed-action" data-action="available" data-id="<%= bed._id %>">Mark available</button><% } %></div></div><% }) %><% if (!wardBeds.length) { %><div class="col-12 text-muted small">No beds configured for this ward.</div><% } %></div></div></div><% }) %></div>
</main></div></div>
<script>
const postJson=async(url,form)=>{const response=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(form)))});const data=await response.json();if(!data.success)throw new Error(data.error);return data;};
document.getElementById('wardForm')?.addEventListener('submit',async event=>{event.preventDefault();try{await postJson('/admin/wards',event.currentTarget);location.reload();}catch(error){document.getElementById('capacityFeedback').textContent=error.message;}});
document.getElementById('bedForm')?.addEventListener('submit',async event=>{event.preventDefault();try{await postJson('/admin/beds',event.currentTarget);location.reload();}catch(error){document.getElementById('capacityFeedback').textContent=error.message;}});
document.getElementById('allocateForm')?.addEventListener('submit',async event=>{event.preventDefault();try{await postJson('/beds/allocate',event.currentTarget);location.reload();}catch(error){alert(error.message);}});
document.querySelectorAll('.bed-action').forEach(button=>button.addEventListener('click',async()=>{const endpoint=button.dataset.action==='release'?'/beds/release':'/beds/available';const response=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({bedId:button.dataset.id})});const data=await response.json();if(data.success)location.reload();else alert(data.error);}));
</script><%- include('../partials/footer') %>
