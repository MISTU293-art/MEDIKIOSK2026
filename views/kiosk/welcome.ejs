  // Set & Switch Language Dynamically
  function setKioskLanguage(lang) {
    if (!kioskDictionary[lang]) lang = 'hi';
    currentKioskLang = lang;
    localStorage.setItem('kiosk_lang', lang);

    // Update active pill button
    document.querySelectorAll('.lang-pill-btn').forEach(btn => btn.classList.remove('active'));
    const activeBtn = document.getElementById(`lang-${lang}`);
    if (activeBtn) activeBtn.classList.add('active');

    const dict = kioskDictionary[lang];

    // Update Text Elements
    const updateText = (id, text) => {
      const el = document.getElementById(id);
      if (el) el.innerText = text;
    };

    updateText('kioskMainTitle', dict.title);
    updateText('kioskMainSubtitle', dict.subtitle);
    updateText('kioskInstruction', dict.instruction);
    updateText('txtCard1Title', dict.card1Title);
    updateText('txtCard1Desc', dict.card1Desc);
    updateText('txtCard1Btn', dict.card1Btn);
    updateText('txtCard2Title', dict.card2Title);
    updateText('txtCard2Desc', dict.card2Desc);
    updateText('txtCard2Btn', dict.card2Btn);
    updateText('txtCard3Title', dict.card3Title);
    updateText('txtCard3Desc', dict.card3Desc);
    updateText('txtCard3Btn', dict.card3Btn);
    updateText('txtBackBtn1', dict.backBtn);
    updateText('txtBackBtn2', dict.backBtn);
    updateText('txtForm1Header', dict.form1Header);
    updateText('txtForm1Sub', dict.form1Sub);
    updateText('lblFullName', dict.lblFullName);
    updateText('lblAge', dict.lblAge);
    updateText('lblGender', dict.lblGender);
    updateText('optMale', dict.optMale);
    updateText('optFemale', dict.optFemale);
    updateText('optOther', dict.optOther);
    updateText('lblPhone', dict.lblPhone);
    updateText('lblDept', dict.lblDept);
    updateText('txtSubmitTokenBtn', dict.submitTokenBtn);
    updateText('txtDetailedLinkPrompt', dict.detailedLinkPrompt);
    updateText('txtForm2Header', dict.form2Header);
    updateText('txtForm2Sub', dict.form2Sub);
    updateText('txtForm2Instruction', dict.form2Instruction);
    updateText('txtFetchTokenBtn', dict.fetchTokenBtn);
    updateText('txtQrPrompt', dict.qrPrompt);
    updateText('txtScanQrBtn', dict.scanQrBtn);
    updateText('txtBottomBannerTitle', dict.bottomBannerTitle);
    updateText('txtBottomBannerSub', dict.bottomBannerSub);
    updateText('txtBottomBannerBtn', dict.bottomBannerBtn);
    updateText('txtStaffLabel', dict.staffLabel);
    updateText('txtSeniorBtn', dict.seniorBtn);
    updateText('txtAudioBtn', dict.audioBtn);
    updateText('txtEmergencyBtn', dict.emergencyBtn);
    updateText('txtPwaBanner', dict.pwaBanner);

    // Update Placeholders
    const fnInput = document.getElementById('expressFullName');
    if (fnInput) fnInput.placeholder = dict.phFullName;
    const ayInput = document.getElementById('ayushmanInput');
    if (ayInput) ayInput.placeholder = dict.phAyushmanInput;
  }

  // Voice speech synthesis
  function speakKioskWelcome() {
    const dict = kioskDictionary[currentKioskLang] || kioskDictionary.hi;
    if (window.readTextAloud) {
      window.readTextAloud(dict.voiceWelcome, currentKioskLang);
    }
  }

  // Simple View Switcher (Main Menu vs New Patient vs Returning Patient)
  function showKioskView(view) {
    const mainView = document.getElementById('kioskMainMenuView');
    const newView = document.getElementById('kioskNewPatientView');
    const retView = document.getElementById('kioskReturningView');

    if (view === 'new-patient') {
      mainView.classList.add('d-none');
      retView.classList.add('d-none');
      newView.classList.remove('d-none');
      const fnInput = document.getElementById('expressFullName');
      if (fnInput) fnInput.focus();
    } else if (view === 'returning-patient') {
      mainView.classList.add('d-none');
      newView.classList.add('d-none');
      retView.classList.remove('d-none');
      const ayInput = document.getElementById('ayushmanInput');
      if (ayInput) ayInput.focus();
    } else {
      newView.classList.add('d-none');
      retView.classList.add('d-none');
      mainView.classList.remove('d-none');
    }
  }

  // Initialize Language on Load
  window.addEventListener('DOMContentLoaded', () => {
    setKioskLanguage(currentKioskLang);
  });

  // PWA Installation Prompt Logic
  let deferredPwaPrompt;
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPwaPrompt = e;
    const banner = document.getElementById('pwaInstallBanner');
    if (banner) banner.classList.remove('d-none');
  });

  const pwaBtn = document.getElementById('pwaInstallBtn');
  if (pwaBtn) {
    pwaBtn.addEventListener('click', async () => {
      if (!deferredPwaPrompt) return;
      deferredPwaPrompt.prompt();
      const choiceResult = await deferredPwaPrompt.userChoice;
      deferredPwaPrompt = null;
      dismissPwaBanner();
    });
  }

  function dismissPwaBanner() {
    const banner = document.getElementById('pwaInstallBanner');
    if (banner) banner.classList.add('d-none');
  }

  // Existing Ayushman & Mobile Lookup Form Handler
  document
    .getElementById("ayushmanLookupForm")
    .addEventListener("submit", async (e) => {
      e.preventDefault();
      const alertBox = document.getElementById("lookupAlert");
      const btn = document.getElementById("lookupBtn");
      const input = document.getElementById("ayushmanInput").value.trim();

      if (!input) {
        document
          .getElementById("ayushmanInput")
          .setCustomValidity("Patient Card Number or Phone is required.");
        document.getElementById("ayushmanInput").reportValidity();
        return;
      }
      document.getElementById("ayushmanInput").setCustomValidity("");

      alertBox.className = "alert mt-3 d-none small";
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Verifying...';

      try {
        const res = await fetch("/kiosk/ayushman-lookup", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ identifier: input }),
        });
        const data = await res.json().catch(() => ({}));
        btn.disabled = false;
        if (!res.ok) throw new Error(data.error || "Lookup request failed");
        
        const dict = kioskDictionary[currentKioskLang] || kioskDictionary.hi;
        btn.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> ${dict.fetchTokenBtn}`;

        if (data.success && data.alreadyRegistered) {
          document.getElementById("recognizedName").innerText = data.patient.fullName;
          document.getElementById("recognizedAgeGender").innerText =
            `${data.patient.age} Yrs / ${data.patient.gender ? data.patient.gender.toUpperCase() : "N/A"}`;
          document.getElementById("recognizedUhid").innerText = data.patient.uhid;
          document.getElementById("recognizedCardNumber").innerText =
            data.patient.cardNumber || data.patient.uhid;
          document.getElementById("recognizedDept").innerText = data.patient.department;
          document.getElementById("recognizedToken").innerText = data.tokenNumber;
          document.getElementById("recognizedRoom").innerText =
            data.roomNumber || "Room 104, AYUSH Wing A";
          document.getElementById("recognizedDoctorName").innerText = (
            data.assignedDoctorName || "Senior Consultant"
          ).split(",")[0];

          document.getElementById("viewCardLink").href = data.cardUrl || `/kiosk/card/${data.patient._id}`;
          document.getElementById("updateIntakeLink").href =
            `/kiosk/intake?lang=${currentKioskLang}&mobile=${encodeURIComponent(data.patient.phone)}&patientId=${encodeURIComponent(data.patient._id)}`;

          const modal = new bootstrap.Modal(document.getElementById("ayushmanRecognizedModal"));
          modal.show();
        } else {
          alertBox.className = "alert alert-info mt-3 d-block small";
          alertBox.innerHTML = '<i class="bi bi-info-circle me-1"></i> No prior record found. Redirecting to Registration...';
          setTimeout(() => {
            const phone = input.replace(/\D/g, "").slice(-10);
            window.location.href =
              phone.length === 10
                ? `/kiosk/intake?lang=${currentKioskLang}&mobile=${encodeURIComponent(phone)}`
                : `/kiosk/intake?lang=${currentKioskLang}`;
          }, 1200);
        }
      } catch (err) {
        btn.disabled = false;
        const dict = kioskDictionary[currentKioskLang] || kioskDictionary.hi;
        btn.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> ${dict.fetchTokenBtn}`;
        alertBox.className = "alert alert-danger mt-3 d-block small";
        alertBox.innerText = "Network error verifying Ayushman card. Please try again.";
      }
    });

  // Express Registration Form Handler (10-Second Quick Register)
  const expressForm = document.getElementById("expressKioskRegisterForm");
  if (expressForm) {
    expressForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const alertBox = document.getElementById("expressAlert");
      const submitBtn = document.getElementById("expressSubmitBtn");

      const fullName = document.getElementById("expressFullName").value.trim();
      const age = parseInt(document.getElementById("expressAge").value);
      const gender = document.getElementById("expressGender").value;
      const phone = document.getElementById("expressPhone").value.trim();
      const preferredDepartment = document.getElementById("expressDepartment").value;

      if (!fullName || !age || !phone || phone.length !== 10) {
        alertBox.className = "alert alert-warning mt-3 d-block small";
        alertBox.innerText = "Please provide valid Name, Age, and 10-digit Mobile number.";
        return;
      }

      alertBox.className = "alert alert-info mt-3 d-block small";
      alertBox.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Registering patient & assigning OPD queue token...';
      submitBtn.disabled = true;

      try {
        const payload = {
          kioskId: "KIOSK-01",
          language: currentKioskLang,
          consent: { medicalDataSharing: true, voiceRecording: false },
          stepData: {
            demographics: {
              fullName,
              age,
              gender,
              phone,
              preferredDepartment,
              ayushmanSchemeType: "General OPD / PM-JAY Fast Registration"
            }
          }
        };

        const res = await fetch("/kiosk/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });

        const data = await res.json().catch(() => ({}));
        submitBtn.disabled = false;

        if (data.success && data.patientId) {
          alertBox.className = "alert alert-success mt-3 d-block small";
          alertBox.innerText = `Registration successful! Token: ${data.tokenNumber}. Opening your card...`;
          
          document.getElementById("recognizedName").innerText = fullName;
          document.getElementById("recognizedAgeGender").innerText = `${age} Yrs / ${gender.toUpperCase()}`;
          document.getElementById("recognizedUhid").innerText = data.uhid || "UHID-GEN";
          document.getElementById("recognizedCardNumber").innerText = data.cardNumber || data.uhid;
          document.getElementById("recognizedDept").innerText = preferredDepartment;
          document.getElementById("recognizedToken").innerText = data.tokenNumber;
          document.getElementById("recognizedRoom").innerText = data.roomNumber || "Room 104, AYUSH Wing A";
          document.getElementById("recognizedDoctorName").innerText = (data.assignedDoctorName || "Senior Consultant").split(",")[0];

          document.getElementById("viewCardLink").href = data.cardUrl || `/kiosk/card/${data.patientId}`;
          document.getElementById("updateIntakeLink").href = `/kiosk/intake?lang=${currentKioskLang}&mobile=${encodeURIComponent(phone)}&patientId=${encodeURIComponent(data.patientId)}`;

          const modal = new bootstrap.Modal(document.getElementById("ayushmanRecognizedModal"));
          modal.show();

          expressForm.reset();
        } else {
          alertBox.className = "alert alert-danger mt-3 d-block small";
          alertBox.innerText = data.error || "Registration could not be completed. Please notify staff.";
        }
      } catch (err) {
        submitBtn.disabled = false;
        alertBox.className = "alert alert-danger mt-3 d-block small";
        alertBox.innerText = "Network error during registration. Please try again or alert staff.";
      }
    });
  }

  // Camera QR Scanner Handler
  document
    .getElementById("patientQrScanButton")
    .addEventListener("click", async () => {
      const camera = document.getElementById("patientQrCamera");
      const status = document.getElementById("patientQrStatus");
      const Detector = window.BarcodeDetector;
      if (!Detector || !navigator.mediaDevices?.getUserMedia) {
        status.textContent = "QR camera scanning is not supported on this device. Enter mobile or card number manually above.";
        return;
      }
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { ideal: "environment" } },
        });
        camera.srcObject = stream;
        camera.classList.remove("d-none");
        status.textContent = "Point the camera at the patient card QR code.";
        const detector = new Detector({ formats: ["qr_code"] });
        const scan = async () => {
          const codes = await detector.detect(camera);
          if (codes.length) {
            document.getElementById("ayushmanInput").value = codes[0].rawValue;
            stream.getTracks().forEach((track) => track.stop());
            camera.classList.add("d-none");
            status.textContent = "Card captured. Verifying...";
            document.getElementById("ayushmanLookupForm").requestSubmit();
          } else if (!camera.classList.contains("d-none"))
            requestAnimationFrame(scan);
        };
        scan();
      } catch (error) {
        if (camera.srcObject) {
          camera.srcObject.getTracks().forEach((track) => track.stop());
          camera.srcObject = null;
        }
        status.textContent = "Camera permission was unavailable. Enter mobile or card number manually above.";
      }
    });
</script>

