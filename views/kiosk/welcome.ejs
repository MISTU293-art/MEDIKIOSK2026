<%- include('../partials/header') %>

<div
  class="container d-flex flex-column align-items-center justify-content-center min-vh-100 py-3 py-md-4"
  style="background: radial-gradient(circle at 50% 15%, #ffffff 0%, #f1f5f9 100%);"
>
  <div
    class="card shadow border-0 rounded-4 overflow-hidden bg-white w-100"
    style="max-width: 860px;"
  >
    <!-- Government National Tricolor Ribbon -->
    <div class="gov-tricolor-bar" style="height: 6px"></div>

    <div class="p-3 p-md-4">
      
      <!-- TOP UTILITY BAR: Language Switcher, Senior Mode & Emergency -->
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom gap-2">
        
        <!-- Left: Official Badges -->
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill" style="font-size: 0.8rem">
            <i class="bi bi-flower1 me-1 text-success"></i> MINISTRY OF AYUSH
          </span>
          <span class="badge bg-success-subtle text-success border border-success px-3 py-1 rounded-pill d-none d-sm-inline" style="font-size: 0.8rem">
            <i class="bi bi-shield-check me-1"></i> Ayushman Bharat (ABDM)
          </span>
        </div>

        <!-- Right: Language Switcher & Accessibility -->
        <div class="d-flex align-items-center gap-1 ms-auto flex-wrap">
          
          <!-- Language Switcher Pills -->
          <div class="btn-group btn-group-sm p-1 bg-light rounded-pill border shadow-xs me-1" role="group" aria-label="Language Selector">
            <button type="button" class="btn btn-sm rounded-pill fw-bold lang-pill-btn active" id="lang-hi" onclick="setKioskLanguage('hi')">
              🇮🇳 हिन्दी
            </button>
            <button type="button" class="btn btn-sm rounded-pill fw-bold lang-pill-btn" id="lang-en" onclick="setKioskLanguage('en')">
              🇬🇧 English
            </button>
            <button type="button" class="btn btn-sm rounded-pill fw-bold lang-pill-btn" id="lang-bn" onclick="setKioskLanguage('bn')">
              🇮🇳 বাংলা
            </button>
          </div>

          <!-- Senior Citizen Mode Toggle -->
          <button
            type="button"
            onclick="window.toggleSeniorMode()"
            class="btn btn-sm btn-outline-warning senior-toggle-btn rounded-pill px-3 py-1 fw-bold text-dark d-flex align-items-center gap-1 shadow-xs"
            title="Senior / Elderly High-Accessibility Mode"
            id="kioskSeniorBtn"
          >
            <i class="bi bi-eyeglasses"></i>
            <span id="txtSeniorBtn">बड़ा टेक्स्ट (Senior Mode)</span>
          </button>

          <!-- Voice Listen Button -->
          <button
            type="button"
            onclick="speakKioskWelcome()"
            class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 fw-semibold d-flex align-items-center gap-1 shadow-xs"
            title="Listen to instructions in audio"
            id="kioskAudioBtn"
          >
            <i class="bi bi-volume-up-fill text-primary"></i>
            <span id="txtAudioBtn">सुने</span>
          </button>

          <!-- 108 Emergency Dial / Button -->
          <a
            href="/kiosk/emergency"
            class="btn btn-sm btn-danger rounded-pill px-3 py-1 fw-bold d-flex align-items-center gap-1 shadow-xs"
            title="Emergency Medical Assistance"
            id="kioskEmergencyBtn"
          >
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span id="txtEmergencyBtn">108 आपातकालीन</span>
          </a>
        </div>
      </div>

      <!-- PWA Mobile Install Banner (Appears on Mobile when ready) -->
      <div id="pwaInstallBanner" class="alert alert-primary d-none py-2 px-3 rounded-pill d-flex align-items-center justify-content-between mb-3 shadow-xs">
        <div class="d-flex align-items-center gap-2 small fw-semibold">
          <i class="bi bi-phone-fill fs-5 text-primary"></i>
          <span id="txtPwaBanner">फोन में MediKiosk ऐप इंस्टॉल करें / Install App for easy access</span>
        </div>
        <div class="d-flex gap-2">
          <button type="button" id="pwaInstallBtn" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold">
            <i class="bi bi-download me-1"></i> Install
          </button>
          <button type="button" onclick="dismissPwaBanner()" class="btn btn-sm btn-light border rounded-circle py-0 px-2" aria-label="Close">
            <i class="bi bi-x"></i>
          </button>
        </div>
      </div>

      <!-- Friendly Clean Header -->
      <div class="text-center mb-4 pt-1">
        <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle p-2 mb-2 shadow-xs" style="width: 68px; height: 68px;">
          <img
            src="/uploads/new_logo.png"
            alt="MediKiosk AYUSH Logo"
            class="img-fluid"
            style="width: 48px; height: 48px; object-fit: contain"
          />
        </div>
        <h2 class="fw-bold text-dark mb-1" id="kioskMainTitle">MediKiosk AYUSH OPD</h2>
        <p class="text-muted mb-0 small fs-6" id="kioskMainSubtitle">
          सरकारी अस्पताल ओपीडी पंजीकरण एवं मरीज सेवा केंद्र &bull; National AYUSH Mission
        </p>
        <p class="text-secondary small mt-1 mb-0" id="kioskInstruction">
          कृपया नीचे दिए गए ३ आसान विकल्पों में से एक चुनें / Please choose an option below:
        </p>
      </div>

      <!-- ============================================== -->
      <!-- VIEW 1: MAIN MENU (3 BIG TOUCH CARDS)          -->
      <!-- ============================================== -->
      <div id="kioskMainMenuView" class="row g-3 mb-4">
        
        <!-- CARD 1: NEW PATIENT (नया मरीज) -->
        <div class="col-md-4">
          <div
            class="card h-100 rounded-4 border-2 p-3 text-center shadow-xs cursor-pointer main-action-card border-success bg-white"
            onclick="showKioskView('new-patient')"
            style="transition: all 0.2s ease;"
          >
            <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow-xs" style="width: 54px; height: 54px; margin: 0 auto;">
              <i class="bi bi-person-plus-fill fs-3"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1" id="txtCard1Title">1. नया मरीज (New Patient)</h5>
            <p class="text-muted small mb-3" id="txtCard1Desc">
              अस्पताल में पहली बार आए हैं? 30 सेकंड में डॉक्टर की पर्ची प्राप्त करें।
            </p>
            <button type="button" class="btn btn-success fw-bold rounded-pill w-100 py-2 mt-auto shadow-xs" id="txtCard1Btn">
              <i class="bi bi-arrow-right-circle me-1"></i> पर्ची निकालें (Register)
            </button>
          </div>
        </div>

        <!-- CARD 2: FAST CHECK-IN / RETURNING (पुराना मरीज) -->
        <div class="col-md-4">
          <div
            class="card h-100 rounded-4 border-2 p-3 text-center shadow-xs cursor-pointer main-action-card border-warning bg-white"
            onclick="showKioskView('returning-patient')"
            style="transition: all 0.2s ease;"
          >
            <div class="bg-warning text-dark rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow-xs" style="width: 54px; height: 54px; margin: 0 auto;">
              <i class="bi bi-person-vcard-fill fs-3"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1" id="txtCard2Title">2. पुराना मरीज (Fast Check-In)</h5>
            <p class="text-muted small mb-3" id="txtCard2Desc">
              मोबाइल नंबर या आयुष्मान/ABHA कार्ड से तुरंत आज का टोकन निकालें।
            </p>
            <button type="button" class="btn btn-warning fw-bold rounded-pill w-100 py-2 mt-auto shadow-xs text-dark" id="txtCard2Btn">
              <i class="bi bi-search me-1"></i> पर्ची खोजें (Fetch Token)
            </button>
          </div>
        </div>

        <!-- CARD 3: PATIENT PORTAL & AI (मरीज पोर्टल और AI) -->
        <div class="col-md-4">
          <div
            class="card h-100 rounded-4 border-2 p-3 text-center shadow-xs cursor-pointer main-action-card border-primary bg-white"
            onclick="window.location.href='/patient/login'"
            style="transition: all 0.2s ease;"
          >
            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow-xs" style="width: 54px; height: 54px; margin: 0 auto;">
              <i class="bi bi-heart-pulse-fill fs-3"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1" id="txtCard3Title">3. मरीज पोर्टल व AI (My Records)</h5>
            <p class="text-muted small mb-3" id="txtCard3Desc">
              अपने पुराने पर्चे, दवाएं, टेस्ट रिपोर्ट देखें या AI सहायक से बात करें।
            </p>
            <button type="button" class="btn btn-primary fw-bold rounded-pill w-100 py-2 mt-auto shadow-xs" id="txtCard3Btn">
              <i class="bi bi-box-arrow-in-right me-1"></i> पोर्टल खोलें (Open Portal)
            </button>
          </div>
        </div>

      </div>

      <!-- ============================================== -->
      <!-- VIEW 2: NEW PATIENT FORM (SHOWN WHEN TAPPED)   -->
      <!-- ============================================== -->
      <div id="kioskNewPatientView" class="d-none">
        
        <!-- Back to Main Menu Button -->
        <div class="d-flex align-items-center justify-content-between mb-3">
          <button type="button" onclick="showKioskView('main-menu')" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-bold d-flex align-items-center gap-1 shadow-xs">
            <i class="bi bi-arrow-left"></i> <span id="txtBackBtn1">‹ वापस जाएं (Back to Menu)</span>
          </button>
          <span class="badge bg-success-subtle text-success border border-success px-3 py-1 rounded-pill small fw-bold">
            <i class="bi bi-check2-circle me-1"></i> Step 1 of 1: Fast Registration
          </span>
        </div>

        <div class="p-4 rounded-4 border shadow-sm bg-white mb-3" style="border-color: #86efac !important; border-width: 2px;">
          <div class="d-flex align-items-center gap-2 mb-3 border-bottom pb-2">
            <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
              <i class="bi bi-person-plus-fill fs-5"></i>
            </div>
            <div>
              <h5 class="fw-bold m-0 text-dark" id="txtForm1Header">नया मरीज ओपीडी पंजीकरण (30 सेकंड)</h5>
              <div class="text-muted small" id="txtForm1Sub">Fill basic details to generate your doctor token slip</div>
            </div>
          </div>

          <!-- Express Kiosk Registration Form -->
          <form id="expressKioskRegisterForm" class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold small text-dark" id="lblFullName">1. मरीज का पूरा नाम (Full Name) *</label>
              <input
                type="text"
                id="expressFullName"
                class="form-control form-control-lg border-2"
                placeholder="उदा. रमेश कुमार (e.g. Ramesh Kumar)"
                required
                minlength="2"
              >
            </div>

            <div class="col-md-3 col-6">
              <label class="form-label fw-bold small text-dark" id="lblAge">2. उम्र (Age) *</label>
              <input
                type="number"
                id="expressAge"
                class="form-control form-control-lg border-2"
                placeholder="Years"
                min="1"
                max="120"
                required
              >
            </div>

            <div class="col-md-3 col-6">
              <label class="form-label fw-bold small text-dark" id="lblGender">3. लिंग (Gender) *</label>
              <select id="expressGender" class="form-select form-select-lg border-2">
                <option value="male" selected id="optMale">पुरुष (Male)</option>
                <option value="female" id="optFemale">महिला (Female)</option>
                <option value="other" id="optOther">अन्य (Other)</option>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-bold small text-dark" id="lblPhone">4. 10-अंकों का मोबाइल नंबर (Mobile No.) *</label>
              <input
                type="tel"
                id="expressPhone"
                class="form-control form-control-lg border-2"
                placeholder="10-digit mobile number"
                maxlength="10"
                pattern="[0-9]{10}"
                required
              >
            </div>

            <div class="col-md-6">
              <label class="form-label fw-bold small text-dark" id="lblDept">5. परामर्श विभाग (Department)</label>
              <select id="expressDepartment" class="form-select form-select-lg border-2">
                <option value="Ayurveda (Kayachikitsa & Panchakarma)" selected>Ayurveda (कायचिकित्सा & पंचकर्म)</option>
                <option value="Homeopathy OPD">Homeopathy (होम्योपैथी)</option>
                <option value="Unani Medicine">Unani (यूनानी चिकित्सा)</option>
                <option value="Siddha Clinical Desk">Siddha (सिद्ध)</option>
                <option value="Yoga & Naturopathy">Yoga & Naturopathy (योग & प्राकृतिक चिकित्सा)</option>
              </select>
            </div>

            <div class="col-12 mt-4">
              <button
                type="submit"
                id="expressSubmitBtn"
                class="btn btn-success w-100 fw-bold fs-5 shadow rounded-pill py-3"
              >
                <i class="bi bi-check-circle-fill me-2"></i> <span id="txtSubmitTokenBtn">पर्ची निकालें (Register & Print OPD Token)</span>
              </button>
            </div>
          </form>

          <div id="expressAlert" class="alert mt-3 d-none small"></div>

          <!-- Secondary Link: Detailed 8-step wizard -->
          <div class="mt-4 pt-3 border-top text-center">
            <span class="text-muted small d-block mb-2" id="txtDetailedLinkPrompt">
              डॉक्टर को पूरी बीमारी और लक्षण विस्तार से बताना चाहते हैं? / Want to record full symptoms?
            </span>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
              <a href="/kiosk/intake?lang=hi" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-semibold text-dark">
                <i class="bi bi-card-checklist me-1 text-warning"></i> विस्तृत केस-टेकिंग (हिन्दी)
              </a>
              <a href="/kiosk/intake?lang=en" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                <i class="bi bi-card-checklist me-1 text-primary"></i> Detailed Intake (English)
              </a>
              <a href="/kiosk/intake?lang=bn" class="btn btn-sm btn-outline-info rounded-pill px-3 fw-semibold text-dark">
                <i class="bi bi-card-checklist me-1 text-info"></i> বিস্তারিত কেস-টেকিং (বাংলা)
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- ============================================== -->
      <!-- VIEW 3: RETURNING / AYUSHMAN FAST CHECK-IN     -->
      <!-- ============================================== -->
      <div id="kioskReturningView" class="d-none">
        
        <!-- Back to Main Menu Button -->
        <div class="d-flex align-items-center justify-content-between mb-3">
          <button type="button" onclick="showKioskView('main-menu')" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-bold d-flex align-items-center gap-1 shadow-xs">
            <i class="bi bi-arrow-left"></i> <span id="txtBackBtn2">‹ वापस जाएं (Back to Menu)</span>
          </button>
          <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-3 py-1 rounded-pill small fw-bold">
            <i class="bi bi-person-vcard me-1"></i> Existing Patient Check-In
          </span>
        </div>

        <div class="p-4 rounded-4 border shadow-sm bg-white mb-3" style="border-color: #fde68a !important; border-width: 2px;">
          <div class="d-flex align-items-center gap-2 mb-3 border-bottom pb-2">
            <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
              <i class="bi bi-person-vcard-fill fs-5"></i>
            </div>
            <div>
              <h5 class="fw-bold m-0 text-dark" id="txtForm2Header">पुराना मरीज / आयुष्मान कार्ड चेक-इन</h5>
              <div class="text-muted small" id="txtForm2Sub">Fetch today's OPD token using registered mobile or ABHA card</div>
            </div>
          </div>

          <p class="text-muted small mb-3" id="txtForm2Instruction">
            अपना पंजीकृत १०-अंकों का मोबाइल नंबर, आयुष्मान/ABHA नंबर, या UHID दर्ज करें:
          </p>

          <!-- Search Form -->
          <form id="ayushmanLookupForm" class="row g-2">
            <div class="col-md-8">
              <div class="input-group input-group-lg">
                <span class="input-group-text bg-light border-warning border-2">
                  <i class="bi bi-telephone-fill text-warning"></i>
                </span>
                <input
                  type="text"
                  id="ayushmanInput"
                  class="form-control form-control-lg border-warning border-2"
                  placeholder="उदा. 9830112233 या ABHA ID"
                  required
                />
              </div>
            </div>
            <div class="col-md-4">
              <button
                type="submit"
                id="lookupBtn"
                class="btn btn-warning w-100 fw-bold fs-6 shadow-sm border-2 h-100 rounded-pill py-2 text-dark"
              >
                <i class="bi bi-check-circle-fill me-1"></i> <span id="txtFetchTokenBtn">पर्ची निकालें (Fetch Token)</span>
              </button>
            </div>
          </form>

          <div id="lookupAlert" class="alert mt-3 d-none small"></div>

          <!-- Camera QR Scanner Button -->
          <div class="mt-4 pt-3 border-top">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="small fw-semibold text-secondary" id="txtQrPrompt">
                <i class="bi bi-qr-code me-1"></i> क्या आपके पास अस्पताल का पर्चा/कार्ड है?
              </span>
            </div>
            <button
              type="button"
              id="patientQrScanButton"
              class="btn btn-outline-primary w-100 rounded-pill py-2 fw-semibold"
            >
              <i class="bi bi-camera me-1"></i> <span id="txtScanQrBtn">कैमरे से कार्ड QR स्कैन करें (Scan Patient Card QR)</span>
            </button>
            <video
              id="patientQrCamera"
              class="w-100 rounded-4 border mt-2 d-none shadow-sm"
              autoplay
              muted
              playsinline
              style="max-height: 220px; object-fit: cover"
            ></video>
            <div id="patientQrStatus" class="form-text text-center mt-1"></div>
          </div>
        </div>

      </div>

      <!-- Quick Patient Portal Banner at Bottom -->
      <div class="p-3 bg-light rounded-4 border d-flex flex-column flex-sm-row align-items-center justify-content-between gap-2 mt-2">
        <div class="d-flex align-items-center gap-2">
          <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
            <i class="bi bi-heart-pulse-fill"></i>
          </div>
          <div>
            <div class="fw-bold text-dark small" id="txtBottomBannerTitle">अपना पुराना पर्चा, दवाएं या रिपोर्ट देखना चाहते हैं?</div>
            <div class="text-muted" style="font-size: 0.78rem;" id="txtBottomBannerSub">Access Digital Card, Prescriptions, Lab Reports & AI Assistant</div>
          </div>
        </div>
        <a href="/patient/login" class="btn btn-primary btn-sm rounded-pill px-3 py-2 fw-bold text-nowrap shadow-xs">
          <i class="bi bi-box-arrow-in-right me-1"></i> <span id="txtBottomBannerBtn">मरीज लॉगिन (Patient Login)</span>
        </a>
      </div>

      <!-- Hospital Staff & Personnel Utility Links -->
      <div class="d-flex align-items-center justify-content-center gap-3 pt-3 mt-3 border-top text-muted small flex-wrap">
        <span class="text-secondary fw-semibold" id="txtStaffLabel">अस्पताल स्टाफ:</span>
        <a href="/auth/login" class="text-decoration-none fw-semibold text-secondary">
          <i class="bi bi-person-badge me-1"></i> Doctor / Staff Login
        </a>
        <span class="text-muted">&bull;</span>
        <a href="/pharmacy" class="text-decoration-none fw-semibold text-success">
          <i class="bi bi-capsule me-1"></i> Pharmacy / दवाखाना
        </a>
        <span class="text-muted">&bull;</span>
        <a href="/kiosk/emergency" class="text-decoration-none fw-bold text-danger">
          <i class="bi bi-exclamation-triangle-fill me-1"></i> 108 Emergency
        </a>
      </div>

    </div>

    <!-- Sub-footer -->
    <div class="card-footer bg-light py-2 text-center text-muted small border-0">
      <i class="bi bi-shield-check text-success me-1"></i> MediKiosk 2026 &bull; Government of India &bull; National AYUSH Mission
    </div>
  </div>
</div>

<!-- Modal: Recognized Patient & Token Generated -->
<div
  class="modal fade"
  id="ayushmanRecognizedModal"
  tabindex="-1"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
      <div
        style="
          height: 6px;
          background: linear-gradient(
            90deg,
            #ff9933 0%,
            #f59e0b 50%,
            #10b981 100%
          );
        "
      ></div>

      <div class="modal-header bg-white border-0 pb-0">
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-warning text-dark fw-bold">
            <i class="bi bi-check2-circle me-1"></i>RECOGNIZED PATIENT
          </span>
          <span class="badge bg-success-subtle text-success border border-success">
            Ayushman Verified
          </span>
        </div>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <div class="modal-body p-4">
        <!-- Ayushman Golden Card Display -->
        <div
          class="p-3 rounded-4 shadow-sm mb-3 position-relative overflow-hidden text-white"
          style="
            background: linear-gradient(135deg, #b45309 0%, #d97706 50%, #f59e0b 100%);
            border: 2px solid #fef3c7;
          "
        >
          <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
