<%- include('../partials/header') %>
<div class="app-layout-wrapper">
  <%- include('../partials/sidebar') %>
  <div class="main-content-wrapper">
    <%- include('../partials/topbar') %>
    <main class="p-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
          <h2 class="fw-bold m-0"><i class="bi bi-stethoscope text-primary me-2"></i>Doctor Consultation Queue</h2>
          <p class="text-muted m-0">Department: <strong><%= user.department || 'Ayurveda & Integrative Medicine' %></strong> &bull; Clinician: <strong><%= user.name %></strong></p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill"><%= patients.length %> Patients in Queue</span>
          <button class="btn btn-success rounded-pill fw-semibold" data-bs-toggle="modal" data-bs-target="#newPatientModal"><i class="bi bi-person-plus me-1"></i> Add Walk-in</button>
        </div>
      </div>

      <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
          <h5 class="fw-bold m-0 text-primary"><i class="bi bi-person-lines-fill me-2"></i>Active Patient Queue</h5>
          <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-light"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="doctorQueueSearch" class="form-control form-control-sm" placeholder="Filter patient or token..." oninput="filterTable('doctorQueueTable', 'doctorQueueSearch')">
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-gov table-hover align-middle" id="doctorQueueTable">
            <thead>
              <tr>
                <th>Priority</th>
                <th>Token</th>
                <th>Patient Name</th>
                <th>Age / Gender</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Consultation Action</th>
              </tr>
            </thead>
            <tbody>
  <% if (!patients || patients.length === 0) { %>
    <tr>
      <td colspan="7" class="text-center py-4 text-muted">
        No patients currently queued in this department.
      </td>
    </tr>
  <% } else { %>

    <% patients.forEach(p => { %>

      <%
        const isEmergency = p.isEmergency === true;

        const patientName = p.fullName || p.name || "Unknown Patient";
        const patientPhone = p.phone || p.mobile || "-";
        const patientAge = p.age || "-";
        const patientGender = p.gender || "-";
        const patientLanguage = (
          p.preferredLanguage || "English"
        ).toUpperCase();

        const priority = p.priority || (
          isEmergency ? "Emergency" : "Normal"
        );
      %>

      <tr class="
        <%= priority === 'Emergency Red-Flag'
          ? 'table-danger'
          : isEmergency
          ? 'table-warning'
          : '' %>
      ">

        <!-- Priority -->
        <td>

          <% if (priority === 'Emergency Red-Flag') { %>

            <span class="badge badge-red-flag">
              <i class="bi bi-exclamation-triangle-fill me-1"></i>
              Red-Flag
            </span>

          <% } else if (priority === 'Emergency') { %>

            <span class="badge bg-danger">
              <i class="bi bi-heart-pulse-fill me-1"></i>
              Emergency
            </span>

          <% } else if (priority === 'Urgent') { %>

            <span class="badge badge-urgent">
              Urgent
            </span>

          <% } else { %>

            <span class="badge badge-normal">
              Normal
            </span>

          <% } %>

        </td>

        <!-- Token -->
        <td>
          <span class="badge bg-primary fs-6">
            <%= p.tokenNumber || "-" %>
          </span>
        </td>

        <!-- Patient -->
        <td>

          <strong>
            <%= patientName %>
          </strong>

          <% if (isEmergency) { %>
            <span class="badge bg-danger ms-1">
              EMERGENCY
            </span>
          <% } %>

          <div class="text-muted small">
            UHID: <%= p.uhid || "-" %>
            &bull;
            Lang: <%= patientLanguage %>
          </div>

        </td>

        <!-- Age / Gender -->
        <td>
          <%= patientAge %> yrs /
          <%= patientGender %>
        </td>

        <!-- Phone -->
        <td>
          <%= patientPhone %>
        </td>

        <!-- Status -->
        <td>

          <% if (p.status === 'completed') { %>

            <span class="badge bg-success">
              Completed
            </span>

          <% } else if (
            p.status === 'in_consultation' ||
            p.status === 'in-progress'
          ) { %>

            <span class="badge bg-primary">
              In Consultation
            </span>

          <% } else if (isEmergency) { %>

            <span class="badge bg-danger">
              Emergency — Ready
            </span>

          <% } else { %>

            <span class="badge bg-warning text-dark">
              Ready for Review
            </span>

          <% } %>

        </td>

        <!-- Action -->
        <td>

          <a
            href="/doctor/patient/<%= p._id %>"
            class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm"
          >
            <i class="bi bi-file-earmark-medical me-1"></i>
            Open Case File
          </a>

        </td>

      </tr>

    <% }) %>

  <% } %>
</tbody>
          </table>
        </div>

        <!-- Pagination Controls -->
        <div id="doctorQueuePagination"></div>
      </div>
    </main>
  </div>
</div>
<div class="modal fade" id="newPatientModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable"><div class="modal-content">
    <form id="doctorPatientForm">
      <div class="modal-header"><h5 class="modal-title">Register Walk-in Patient</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body row g-3">
        <div class="col-12"><label class="form-label">Full name *</label><input name="fullName" class="form-control" required minlength="2"></div>
        <div class="col-6"><label class="form-label">Age *</label><input name="age" type="number" min="0" max="120" class="form-control" required></div>
        <div class="col-6"><label class="form-label">Gender *</label><select name="gender" class="form-select" required><option value="">Select</option><option value="female">Female</option><option value="male">Male</option><option value="other">Other</option></select></div>
        <div class="col-12"><label class="form-label">Mobile number *</label><input name="phone" inputmode="numeric" pattern="[0-9]{10}" class="form-control" required></div>
        <div class="col-12"><label class="form-label">Medical history</label><textarea name="medicalHistory" class="form-control" rows="2"></textarea></div>
        <div class="col-12"><label class="form-label">Allergies and current medicines</label><textarea name="allergies" class="form-control" rows="2"></textarea></div>
        <div id="doctorPatientFeedback" class="col-12" role="alert"></div>
      </div><div class="modal-footer"><button class="btn btn-primary" type="submit">Create patient</button></div>
    </form>
  </div></div>
</div>
<script src="/js/pagination.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  initTablePagination('doctorQueueTable', 'doctorQueuePagination', 6);
  document.getElementById('doctorPatientForm').addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!form.checkValidity()) { form.classList.add('was-validated'); return; }
    const feedback = document.getElementById('doctorPatientFeedback');
    const response = await fetch('/doctor/patients', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
    const data = await response.json();
    if (!data.success) { feedback.className = 'col-12 alert alert-danger'; feedback.textContent = data.error || 'Unable to register patient.'; return; }
    feedback.className = 'col-12 alert alert-success'; feedback.textContent = `Patient created. Card: ${data.cardNumber}`;
    setTimeout(() => window.location.reload(), 700);
  });
});
</script>
<%- include('../partials/footer') %>