<%- include('../partials/header') %>
<div class="app-layout-wrapper"><%- include('../partials/sidebar') %><div class="main-content-wrapper"><%- include('../partials/topbar') %>
<main class="p-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h2 class="fw-bold m-0">Reports & Tests</h2><p class="text-muted m-0">Request investigations and track clinical results.</p></div></div>
<div class="row g-4"><div class="col-xl-5"><div class="card border-0 shadow-sm p-4"><h5 class="fw-bold mb-3">Request a report</h5><form id="reportForm"><label class="form-label">Patient *</label><select name="patientId" class="form-select mb-3" required><option value="">Select patient</option><% patients.forEach(patient => { %><option value="<%= patient._id %>"><%= patient.fullName %> · <%= patient.cardNumber || patient.uhid %></option><% }) %></select><label class="form-label">Test *</label><select name="reportType" class="form-select mb-3" required><option value="">Select test</option><option>CBC</option><option>Blood Sugar</option><option>X-Ray</option><option>MRI</option><option>CT Scan</option><option>Ultrasound</option><option>ECG</option><option>Custom Test</option></select><label class="form-label">Priority</label><select name="priority" class="form-select mb-3"><option value="routine">Routine</option><option value="urgent">Urgent</option><option value="stat">STAT</option></select><label class="form-label">Instructions</label><textarea name="instructions" class="form-control mb-3" rows="3"></textarea><div id="reportFeedback" role="alert"></div><button class="btn btn-primary w-100" type="submit">Request report</button></form></div></div>
<div class="col-xl-7"><div class="card border-0 shadow-sm p-4"><h5 class="fw-bold mb-3">My requested reports</h5><div class="table-responsive"><table class="table table-gov align-middle"><thead><tr><th>Patient</th><th>Test</th><th>Priority</th><th>Status</th></tr></thead><tbody><% if (!reports.length) { %><tr><td colspan="4" class="text-center text-muted py-4">No reports requested yet.</td></tr><% } %><% reports.forEach(report => { const patient = patients.find(item => String(item._id) === report.patientId); %><tr><td><%= patient ? patient.fullName : 'Patient' %></td><td><%= report.reportType %></td><td><%= report.priority.toUpperCase() %></td><td><span class="badge bg-info text-dark"><%= report.status %></span></td></tr><% }) %></tbody></table></div></div></div></div></main></div></div>
<script>document.getElementById('reportForm').addEventListener('submit', async event => { event.preventDefault(); const form = event.currentTarget; if (!form.checkValidity()) { form.classList.add('was-validated'); return; } const response = await fetch('/doctor/reports', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) }); const data = await response.json(); const feedback = document.getElementById('reportFeedback'); feedback.className = data.success ? 'alert alert-success' : 'alert alert-danger'; feedback.textContent = data.success ? 'Report requested.' : data.error; if (data.success) setTimeout(() => location.reload(), 500); });</script>
<%- include('../partials/footer') %>