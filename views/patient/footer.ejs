      </a>
      <a href="/patient/dashboard#medicines" onclick="if(typeof switchDashboardTab === 'function'){ switchDashboardTab('medicines'); return false; }" class="mobile-nav-item <%= (typeof activeNav !== 'undefined' && (activeNav === 'visits' || activeNav === 'prescriptions' || activeNav === 'medicines')) ? 'active' : '' %>">
