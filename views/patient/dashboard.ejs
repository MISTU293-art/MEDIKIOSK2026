          <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-xs" style="width: 38px; height: 38px;">
            <i class="bi bi-robot fs-5"></i>
          </div>
          <div>
            <h5 class="fw-bold text-dark mb-0 fs-6">MediKiosk AI Health Assistant</h5>
            <div class="text-muted small" style="font-size: 0.75rem;">Record-aware AI guidance &bull; Non-diagnostic informational assistant</div>
          </div>
