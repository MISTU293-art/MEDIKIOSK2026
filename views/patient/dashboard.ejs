<%- include('header', { title: 'Dashboard — MediKiosk Patient Portal', patient, activeNav: 'dashboard' }) %>

<div class="container-fluid px-3 px-lg-4 py-4">

  <!-- Top Accessibility, Senior Citizen & Back Switcher Bar -->
  <div class="senior-toggle-bar mb-3">
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <a href="/kiosk" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold shadow-xs">
        <i class="bi bi-arrow-left-circle me-1"></i> Back to Kiosk / कियोस्क
      </a>
      <button type="button" onclick="window.toggleSeniorMode()" class="btn btn-sm btn-outline-warning senior-toggle-btn rounded-pill px-3 fw-bold text-dark shadow-xs">
        <i class="bi bi-eyeglasses me-1"></i> Senior View (बड़ा टेक्स्ट)
      </button>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <button type="button" onclick="window.readTextAloud('Welcome <%= (patient.fullName || '').replace(/'/g, '') %>. Your Patient Card number is <%= patientCard.patientCardNumber %> and your UHID is <%= patient.uhid %>. Your current token is <%= patient.tokenNumber || 'T-101' %> for <%= (patient.department || 'AYUSH OPD').replace(/'/g, '') %>.')" class="btn btn-sm btn-outline-primary rounded-pill px-3 voice-read-btn fw-semibold shadow-xs" title="Listen to summary">
        <i class="bi bi-volume-up-fill me-1"></i> Read Out / सुनें
      </button>
      <a href="tel:108" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold shadow-xs" title="Emergency Ambulance Call">
        <i class="bi bi-telephone-fill me-1"></i> 108 Emergency
      </a>
    </div>
  </div>

  <!-- Welcome & Top Cards (Section 45) -->
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <h2 class="fw-bold text-dark mb-0">Welcome, <%= patient.fullName %></h2>
        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.75rem;">
          <i class="bi bi-shield-check"></i> Authenticated
        </span>
      </div>
      <p class="text-muted mb-0 small">
        Your personal digital healthcare dashboard & continuous health compass.
      </p>
    </div>

    <!-- Quick Actions -->
    <div class="d-flex align-items-center gap-2">
      <a href="/patient/card" class="btn btn-outline-primary d-flex align-items-center gap-2 shadow-sm">
        <i class="bi bi-credit-card-2-front"></i>
        <span>My Patient Card</span>
      </a>
      <a href="/patient/chat" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
        <i class="bi bi-robot"></i>
        <span>AI Health Assistant</span>
      </a>
    </div>
  </div>

  <!-- Identifiers Banner (UHID & Card No) -->
  <div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
      <div class="portal-card p-3 h-100">
        <div class="text-muted small mb-1">Universal Health ID (UHID)</div>
        <div class="d-flex align-items-center justify-content-between">
          <span class="uhid-pill fs-6"><%= patient.uhid %></span>
          <i class="bi bi-hash text-primary fs-4"></i>
        </div>
        <div class="text-muted mt-2" style="font-size: 0.75rem;">Verified across National AYUSH Network</div>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="portal-card p-3 h-100">
        <div class="text-muted small mb-1">Patient Card Number</div>
        <div class="d-flex align-items-center justify-content-between">
          <span class="uhid-pill fs-6 text-primary"><%= patientCard.patientCardNumber %></span>
          <i class="bi bi-credit-card text-success fs-4"></i>
        </div>
        <div class="text-muted mt-2" style="font-size: 0.75rem;">Safe Barcode & QR Code active</div>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="portal-card p-3 h-100">
        <div class="text-muted small mb-1">Current Healthcare Visit</div>
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-primary px-2 py-1 fs-6">Token <%= patient.tokenNumber || 'T-101' %></span>
          <i class="bi bi-hospital text-info fs-4"></i>
        </div>
        <div class="text-muted mt-2 text-truncate" style="font-size: 0.75rem;">
          <%= patient.department || 'Ayurveda & AYUSH OPD' %>
        </div>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="portal-card p-3 h-100">
        <div class="text-muted small mb-1">Ayushman / ABHA Identity</div>
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-warning-subtle text-warning-emphasis border px-2 py-1" style="font-size: 0.85rem;">
            <%= patient.abhaId ? patient.abhaId : 'ABHA Ready' %>
          </span>
          <i class="bi bi-fingerprint text-warning fs-4"></i>
        </div>
        <div class="text-muted mt-2 text-truncate" style="font-size: 0.75rem;">PM-JAY Scheme Linked</div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- LEFT COLUMN: Quick Access & AI Chat Preview -->
    <div class="col-lg-8">
      
      <!-- Quick Access Grid (Section 45) -->
      <div class="portal-card p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
          <h5 class="fw-bold text-dark mb-0"><i class="bi bi-grid-fill text-primary me-2"></i>Quick Access Records</h5>
          <span class="badge bg-light text-muted border">Authorized Patient Data</span>
        </div>

        <div class="row g-3">
          <div class="col-6 col-md-4">
            <a href="/patient/reports" class="text-decoration-none">
              <div class="p-3 border rounded-3 bg-light text-center h-100 hover-shadow transition">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 44px; height: 44px;">
                  <i class="bi bi-file-earmark-medical fs-5"></i>
                </div>
                <div class="fw-bold text-dark small">My Reports</div>
                <div class="text-muted" style="font-size: 0.75rem;"><%= reports.length %> Available</div>
              </div>
            </a>
          </div>

          <div class="col-6 col-md-4">
            <a href="/patient/medicines" class="text-decoration-none">
              <div class="p-3 border rounded-3 bg-light text-center h-100 hover-shadow transition">
                <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 44px; height: 44px;">
                  <i class="bi bi-capsule fs-5"></i>
                </div>
                <div class="fw-bold text-dark small">Medicines</div>
                <div class="text-muted" style="font-size: 0.75rem;"><%= medicines.length %> Recorded</div>
              </div>
            </a>
          </div>

          <div class="col-6 col-md-4">
            <a href="/patient/visits" class="text-decoration-none">
              <div class="p-3 border rounded-3 bg-light text-center h-100 hover-shadow transition">
                <div class="bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 44px; height: 44px;">
                  <i class="bi bi-calendar-week fs-5"></i>
                </div>
                <div class="fw-bold text-dark small">Visits</div>
                <div class="text-muted" style="font-size: 0.75rem;"><%= visits.length %> Visits</div>
              </div>
            </a>
          </div>

          <div class="col-6 col-md-4">
            <a href="/patient/prescriptions" class="text-decoration-none">
              <div class="p-3 border rounded-3 bg-light text-center h-100 hover-shadow transition">
                <div class="bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 44px; height: 44px;">
                  <i class="bi bi-prescription fs-5"></i>
                </div>
                <div class="fw-bold text-dark small">Prescriptions</div>
                <div class="text-muted" style="font-size: 0.75rem;"><%= prescriptions.length %> Items</div>
              </div>
            </a>
          </div>

          <div class="col-6 col-md-4">
            <a href="/patient/documents" class="text-decoration-none">
              <div class="p-3 border rounded-3 bg-light text-center h-100 hover-shadow transition">
                <div class="bg-secondary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 44px; height: 44px;">
                  <i class="bi bi-folder2 fs-5"></i>
                </div>
                <div class="fw-bold text-dark small">Documents</div>
                <div class="text-muted" style="font-size: 0.75rem;"><%= (typeof documents !== 'undefined' && documents ? documents.length : (reports || []).length) %> Files</div>
              </div>
            </a>
          </div>

          <div class="col-6 col-md-4">
            <a href="/patient/timeline" class="text-decoration-none">
              <div class="p-3 border rounded-3 bg-light text-center h-100 hover-shadow transition">
                <div class="bg-dark text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 44px; height: 44px;">
                  <i class="bi bi-clock-history fs-5"></i>
                </div>
                <div class="fw-bold text-dark small">Medical Timeline</div>
                <div class="text-muted" style="font-size: 0.75rem;">Intelligence View</div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- AI Health Assistant Section (Section 45 & 57) -->
      <div class="portal-card p-4 mb-4 border-primary border-opacity-25" style="background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 100%);">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div class="d-flex align-items-center gap-3">
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
              <i class="bi bi-robot fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold text-dark mb-0">MediKiosk AI Health Assistant</h5>
              <div class="text-muted small">"How can I help you today with your medical records?"</div>
            </div>
          </div>
          <a href="/patient/chat" class="btn btn-primary shadow-sm px-3 py-2 fw-semibold">
            <i class="bi bi-chat-dots-fill me-1"></i> Start Chat
          </a>
        </div>

        <!-- Dynamic Quick Action Chips (Section 64) -->
        <div class="mt-3">
          <div class="small fw-semibold text-secondary mb-2">Ask MediKiosk AI Quick Actions:</div>
          <div class="d-flex flex-wrap gap-2">
            <% suggestedQuestions.slice(0, 5).forEach(function(sq) { %>
              <a href="/patient/chat?q=<%= encodeURIComponent(sq) %>" class="btn btn-sm btn-white bg-white border text-primary shadow-xs rounded-pill px-3 py-1">
                <i class="bi bi-arrow-right-short text-muted"></i> <%= sq %>
              </a>
            <% }); %>
          </div>
        </div>
      </div>

      <!-- Lab Results Highlights (Section 55) -->
      <div class="portal-card p-4">
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
          <h5 class="fw-bold text-dark mb-0"><i class="bi bi-activity text-danger me-2"></i>Recent Lab Results</h5>
          <a href="/patient/labs" class="small text-primary text-decoration-none fw-semibold">View All Labs &rarr;</a>
        </div>

        <div class="row g-3">
          <% labResults.slice(0, 3).forEach(function(lab) { %>
            <div class="col-md-4">
              <div class="p-3 border rounded-3 bg-white h-100">
                <div class="text-muted small text-truncate"><%= lab.parameter %></div>
                <div class="fs-4 fw-bold text-dark my-1">
                  <%= lab.value %> <span class="fs-6 fw-normal text-muted"><%= lab.unit %></span>
                </div>
                <div class="d-flex align-items-center justify-content-between mt-2">
                  <span class="badge <%= lab.isPotentiallyAbnormal ? 'badge-soft-warning' : 'badge-soft-success' %>">
                    <%= lab.status %>
                  </span>
                  <span class="text-muted" style="font-size: 0.7rem;"><%= new Date(lab.reportDate).toLocaleDateString() %></span>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN: Recent Activity, Digital Card Quick Box, Notifications -->
    <div class="col-lg-4">
      
      <!-- Patient Card Quick Access Widget (Section 46) -->
      <div class="portal-card p-3 mb-4 text-white" style="background: linear-gradient(135deg, #1e3a8a 0%, #0284c7 100%);">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <div class="small text-white-50 text-uppercase tracking-wider" style="font-size: 0.7rem;">Hospital Health Card</div>
            <div class="fw-bold fs-5"><%= patientCard.patientName %></div>
          </div>
          <span class="badge bg-white text-dark px-2 py-1 font-monospace" style="font-size: 0.75rem;"><%= patientCard.patientCardNumber %></span>
        </div>

        <div class="row my-2 g-1 small text-white-75">
          <div class="col-6">UHID: <strong class="text-white"><%= patientCard.uhid %></strong></div>
          <div class="col-6">Age / Sex: <strong class="text-white"><%= patientCard.age %> / <%= patientCard.gender %></strong></div>
          <div class="col-6">Mobile: <strong class="text-white"><%= patientCard.maskedPhone %></strong></div>
          <div class="col-6">Blood: <strong class="text-white"><%= patientCard.bloodGroup %></strong></div>
        </div>

        <div class="d-flex align-items-center justify-content-between pt-2 border-top border-white-50 border-opacity-25 mt-2">
          <div class="small text-white-50" style="font-size: 0.72rem;">Safe QR & Barcode Verified</div>
          <a href="/patient/card" class="btn btn-sm btn-light py-1 px-3 fw-semibold text-primary">Open Full Card</a>
        </div>
      </div>

      <!-- Real-Time Notifications (Section 77) -->
      <div class="portal-card p-3 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
          <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-bell-fill text-warning me-2"></i>Notifications</h6>
          <span class="badge bg-light text-muted"><%= notifications.length %></span>
        </div>
        <% if (notifications.length > 0) { %>
          <div class="list-group list-group-flush">
            <% notifications.forEach(function(n) { %>
              <a href="<%= n.link || '/patient/dashboard' %>" class="list-group-item list-group-item-action px-2 py-2 border-0 rounded-2 mb-1">
                <div class="d-flex w-100 justify-content-between align-items-center">
                  <strong class="small text-dark"><%= n.title %></strong>
                  <small class="text-muted" style="font-size: 0.68rem;"><%= new Date(n.createdAt).toLocaleDateString() %></small>
                </div>
                <p class="mb-0 text-muted small text-truncate"><%= n.message %></p>
              </a>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-muted small py-3 text-center">
            <i class="bi bi-check2-circle text-success fs-5 d-block mb-1"></i>
            All caught up! No unread notifications.
          </div>
        <% } %>
      </div>

      <!-- Recent Activity Feed (Section 45) -->
      <div class="portal-card p-3 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
          <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-journal-medical text-primary me-2"></i>Recent Activity</h6>
          <a href="/patient/timeline" class="small text-primary text-decoration-none">Timeline &rarr;</a>
        </div>

        <ul class="list-unstyled mb-0" style="font-size: 0.85rem;">
          <li class="py-2 border-bottom d-flex align-items-start gap-2">
            <i class="bi bi-check-circle-fill text-success mt-1"></i>
            <div>
              <div class="fw-semibold text-dark">Doctor consultation recorded</div>
              <div class="text-muted small">Clinical intake and summary approved</div>
            </div>
          </li>
          <li class="py-2 border-bottom d-flex align-items-start gap-2">
            <i class="bi bi-file-earmark-check text-info mt-1"></i>
            <div>
              <div class="fw-semibold text-dark">Blood report evaluated</div>
              <div class="text-muted small">CBC laboratory profile reviewed</div>
            </div>
          </li>
          <li class="py-2 border-bottom d-flex align-items-start gap-2">
            <i class="bi bi-capsule text-warning mt-1"></i>
            <div>
              <div class="fw-semibold text-dark">Prescription generated</div>
              <div class="text-muted small">Dosage instructions confirmed</div>
            </div>
          </li>
          <li class="py-2 d-flex align-items-start gap-2">
            <i class="bi bi-calendar2-heart text-primary mt-1"></i>
            <div>
              <div class="fw-semibold text-dark">Follow-up schedule created</div>
              <div class="text-muted small">Review date synchronized with clinic</div>
            </div>
          </li>
        </ul>
      </div>

      <!-- Recorded Allergies Banner (Section 52) -->
      <div class="portal-card p-3">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-exclamation text-danger me-2"></i>Recorded Allergies</h6>
          <a href="/patient/allergies" class="small text-primary text-decoration-none">View All</a>
        </div>
        <% if (allergies && allergies.hasAllergies) { %>
          <div class="d-flex flex-wrap gap-1">
            <% (allergies.drugAllergies || []).forEach(function(al) { %>
              <span class="badge badge-soft-danger px-2 py-1"><i class="bi bi-exclamation-octagon me-1"></i><%= al %></span>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-muted small">No known drug allergies (NKDA) currently flagged.</div>
        <% } %>
      </div>

    </div>
  </div>

</div>

<%- include('footer') %>
