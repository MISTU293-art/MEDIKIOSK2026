<%- include('header', { title: 'Dashboard — MediKiosk Patient Portal', patient, activeNav: 'dashboard' }) %>

<style>
  /* Dashboard In-Place Tab Panel Styles */
  .dash-tab-pill {
    color: #475569;
    font-weight: 600;
    padding: 0.55rem 1rem;
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
    background-color: #ffffff;
    font-size: 0.88rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
  }
  .dash-tab-pill:hover {
    background-color: #f1f5f9;
    color: #0284c7;
    border-color: #cbd5e1;
  }
  .dash-tab-pill.active {
    background-color: #0284c7 !important;
    color: #ffffff !important;
    border-color: #0284c7 !important;
    box-shadow: 0 2px 6px rgba(2, 132, 199, 0.25);
  }
  .dash-panel-pane {
    display: none;
  }
  .dash-panel-pane.active {
    display: block;
    animation: fadeInTab 0.2s ease-in-out;
  }
  @keyframes fadeInTab {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hover-card-btn {
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .hover-card-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08) !important;
  }
  @media (max-width: 576px) {
    .dash-tab-pill {
      font-size: 0.8rem;
      padding: 0.45rem 0.75rem;
    }
    .portal-card {
      padding: 1rem !important;
    }
  }
</style>
<%
  /*
   * ============================================================
   * SAFE DASHBOARD DATA
   * Computed ONCE here and reused everywhere below. (Previously
   * this same computation was repeated with a second `const`
   * declaration further down the file, which threw
   * "Identifier 'dashboardTimeline' has already been declared"
   * and crashed the page on every render.)
   * ============================================================
   */

  const safeTimeline = timeline && typeof timeline === 'object'
    ? timeline
    : {};

  const timelineYears = Array.isArray(safeTimeline.years)
    ? safeTimeline.years
    : [];

  const dashboardTimeline = timelineYears
    .flatMap(function(yearGroup) {
      return yearGroup && Array.isArray(yearGroup.events)
        ? yearGroup.events
        : [];
    })
    .filter(Boolean)
    .sort(function(a, b) {
      const dateA = a && a.date ? new Date(a.date).getTime() : 0;
      const dateB = b && b.date ? new Date(b.date).getTime() : 0;

      return dateB - dateA;
    });

  const timelineEventCount = Number(
    safeTimeline.totalEvents || dashboardTimeline.length || 0
  );

  const recentTimeline = dashboardTimeline.slice(0, 5);

  // Pre-built, HTML-escaped read-aloud text. Rendered into a
  // data-* attribute (see below) instead of directly into an
  // inline onclick JS string, so a patient name/department
  // containing a quote character can't break out of the JS
  // string and execute arbitrary script.
  const readAloudText =
    'Welcome ' + (patient.fullName || '') + '. ' +
    'Your Patient Card number is ' + (patientCard.patientCardNumber || '') + ' ' +
    'and your UHID is ' + (patient.uhid || '') + '. ' +
    'Your current token is ' + (patient.tokenNumber || 'T-101') + ' ' +
    'for ' + (patient.department || 'AYUSH OPD') + '.';
%>
<div class="container-fluid px-3 px-lg-4 py-3 py-md-4">

  <!-- Top Accessibility, Senior Citizen & Back Switcher Bar -->
  <div class="senior-toggle-bar mb-3">
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <a href="/kiosk" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold shadow-xs">
        <i class="bi bi-arrow-left-circle me-1"></i> Back to Kiosk / कियोस्क
      </a>
      <button type="button" onclick="window.toggleSeniorMode()" class="btn btn-sm btn-outline-warning senior-toggle-btn rounded-pill px-3 fw-bold text-dark shadow-xs">
        <i class="bi bi-eyeglasses me-1"></i> Senior View (बड़ा टेक्स्ट)
      </button>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <button type="button" data-read-text="<%= readAloudText %>" onclick="window.readTextAloud(this.dataset.readText)" class="btn btn-sm btn-outline-primary rounded-pill px-3 voice-read-btn fw-semibold shadow-xs" title="Listen to summary">
        <i class="bi bi-volume-up-fill me-1"></i> Read Out / सुनें
      </button>
      <a href="tel:108" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold shadow-xs" title="Emergency Ambulance Call">
        <i class="bi bi-telephone-fill me-1"></i> 108 Emergency
      </a>
    </div>
  </div>

  <!-- Welcome Header -->
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
        <h2 class="fw-bold text-dark mb-0 fs-3">Welcome, <%= patient.fullName %></h2>
        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.75rem;">
          <i class="bi bi-shield-check"></i> Authenticated
        </span>
      </div>
      <p class="text-muted mb-0 small">
        Universal Healthcare Portal &bull; All records accessible in one unified panel
      </p>
    </div>

    <!-- Quick Switcher Buttons -->
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <button type="button" onclick="switchDashboardTab('card')" class="btn btn-outline-primary btn-sm rounded-pill d-flex align-items-center gap-2 shadow-xs fw-semibold">
        <i class="bi bi-credit-card-2-front"></i>
        <span>My Patient Card</span>
      </button>
      <a href="/patient/chat" class="btn btn-primary btn-sm rounded-pill d-flex align-items-center gap-2 shadow-xs fw-semibold">
        <i class="bi bi-robot"></i>
        <span>AI Health Assistant</span>
      </a>
    </div>
  </div>

  <!-- IN-DASHBOARD UNIFIED TAB SWITCHER BAR -->
  <div class="mb-4 overflow-auto py-1" style="white-space: nowrap; scrollbar-width: none;">
    <div class="d-inline-flex gap-2">
      <button type="button" class="dash-tab-pill active" id="pill-overview" onclick="switchDashboardTab('overview')">
        <i class="bi bi-speedometer2"></i> Overview (मुख्य)
      </button>
      <button type="button" class="dash-tab-pill" id="pill-card" onclick="switchDashboardTab('card')">
        <i class="bi bi-credit-card-2-front-fill"></i> Health Card (कार्ड)
      </button>
      <button type="button" class="dash-tab-pill" id="pill-medicines" onclick="switchDashboardTab('medicines')">
        <i class="bi bi-capsule"></i> Medicines & Rx (दवाएं)
      </button>
      <button type="button" class="dash-tab-pill" id="pill-reports" onclick="switchDashboardTab('reports')">
        <i class="bi bi-file-earmark-medical-fill"></i> Reports & Labs (रिपोर्ट)
      </button>
      <button type="button" class="dash-tab-pill" id="pill-visits" onclick="switchDashboardTab('visits')">
        <i class="bi bi-calendar-check-fill"></i> Visits & History (जांच)
      </button>
      <button type="button" class="dash-tab-pill" id="pill-ai" onclick="switchDashboardTab('ai')">
        <i class="bi bi-robot"></i> AI Health Assistant
      </button>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- TAB PANE 1: OVERVIEW (DEFAULT)                           -->
  <!-- ======================================================== -->
  <div class="dash-panel-pane active" id="pane-overview">

    <!-- Identifiers Banner (UHID, Card No, Token, ABHA) -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="portal-card p-3 h-100">
          <div class="text-muted small mb-1" style="font-size: 0.75rem;">UHID Number</div>
          <div class="d-flex align-items-center justify-content-between">
            <span class="uhid-pill fs-6 text-truncate" style="max-width: 130px;"><%= patient.uhid %></span>
            <i class="bi bi-hash text-primary fs-5"></i>
          </div>
          <div class="text-muted mt-2 small" style="font-size: 0.72rem;">AYUSH Grid Verified</div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <div class="portal-card p-3 h-100 cursor-pointer" onclick="switchDashboardTab('card')">
          <div class="text-muted small mb-1" style="font-size: 0.75rem;">Patient Card</div>
          <div class="d-flex align-items-center justify-content-between">
            <span class="uhid-pill fs-6 text-primary text-truncate" style="max-width: 130px;"><%= patientCard.patientCardNumber %></span>
            <i class="bi bi-credit-card text-success fs-5"></i>
          </div>
          <div class="text-muted mt-2 small" style="font-size: 0.72rem;">Tap to view card &rarr;</div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <div class="portal-card p-3 h-100 cursor-pointer" onclick="switchDashboardTab('visits')">
          <div class="text-muted small mb-1" style="font-size: 0.75rem;">Today's OPD Token</div>
          <div class="d-flex align-items-center justify-content-between">
            <span class="badge bg-primary px-2 py-1 fs-6"><%= patient.tokenNumber || 'T-101' %></span>
            <i class="bi bi-hospital text-info fs-5"></i>
          </div>
          <div class="text-muted mt-2 text-truncate small" style="font-size: 0.72rem;">
            <%= patient.department || 'Ayurveda & AYUSH OPD' %>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <div class="portal-card p-3 h-100">
          <div class="text-muted small mb-1" style="font-size: 0.75rem;">Ayushman / ABHA</div>
          <div class="d-flex align-items-center justify-content-between">
            <span class="badge bg-warning-subtle text-warning-emphasis border px-2 py-1 text-truncate" style="max-width: 120px; font-size: 0.8rem;">
              <%= patient.abhaId ? patient.abhaId : 'ABHA Ready' %>
            </span>
            <i class="bi bi-fingerprint text-warning fs-5"></i>
          </div>
          <div class="text-muted mt-2 text-truncate small" style="font-size: 0.72rem;">PM-JAY Linked</div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <!-- LEFT COLUMN -->
      <div class="col-lg-8">

        <!-- Quick Access Records Grid -->
        <div class="portal-card p-3 p-md-4 mb-4">
          <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
            <h5 class="fw-bold text-dark mb-0 fs-6"><i class="bi bi-grid-fill text-primary me-2"></i>Quick Records Navigation</h5>
            <span class="badge bg-light text-muted border">Tap to view instantly</span>
          </div>

          <div class="row g-2 g-md-3">
            <div class="col-6 col-md-4">
              <div class="p-3 border rounded-3 bg-light text-center h-100 cursor-pointer hover-card-btn" onclick="switchDashboardTab('card')">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow-xs" style="width: 44px; height: 44px;">
                  <i class="bi bi-credit-card-2-front fs-5"></i>
                </div>
                <div class="fw-bold text-dark small">My Health Card</div>
                <div class="text-muted" style="font-size: 0.72rem;">Safe QR & Barcode</div>
              </div>
            </div>

            <div class="col-6 col-md-4">
              <div class="p-3 border rounded-3 bg-light text-center h-100 cursor-pointer hover-card-btn" onclick="switchDashboardTab('reports')">
                <div class="bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow-xs" style="width: 44px; height: 44px;">
                  <i class="bi bi-file-earmark-medical fs-5"></i>
                </div>
                <div class="fw-bold text-dark small">My Reports</div>
                <div class="text-muted" style="font-size: 0.72rem;"><%= reports.length %> Lab Records</div>
              </div>
            </div>

            <div class="col-6 col-md-4">
              <div class="p-3 border rounded-3 bg-light text-center h-100 cursor-pointer hover-card-btn" onclick="switchDashboardTab('medicines')">
                <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow-xs" style="width: 44px; height: 44px;">
                  <i class="bi bi-capsule fs-5"></i>
                </div>
                <div class="fw-bold text-dark small">Medicines</div>
                <div class="text-muted" style="font-size: 0.72rem;"><%= medicines.length %> Prescriptions</div>
              </div>
            </div>

            <div class="col-6 col-md-4">
              <div class="p-3 border rounded-3 bg-light text-center h-100 cursor-pointer hover-card-btn" onclick="switchDashboardTab('visits')">
                <div class="bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow-xs" style="width: 44px; height: 44px;">
                  <i class="bi bi-calendar-check fs-5"></i>
                </div>
                <div class="fw-bold text-dark small">Doctor Visits</div>
                <div class="text-muted" style="font-size: 0.72rem;"><%= visits.length %> Visits</div>
              </div>
            </div>

            <div class="col-6 col-md-4">
              <div class="p-3 border rounded-3 bg-light text-center h-100 cursor-pointer hover-card-btn" onclick="switchDashboardTab('visits')">
                <div class="bg-dark text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow-xs" style="width: 44px; height: 44px;">
                  <i class="bi bi-clock-history fs-5"></i>
                </div>
                <div class="fw-bold text-dark small">Medical Timeline</div>
                <!-- FIX: was `timeline.length` (undefined — timeline is
                     { years: [...] }, not an array). Use the event
                     count computed once at the top of the file. -->
                <div class="text-muted" style="font-size: 0.72rem;"><%= timelineEventCount %> Clinical Events</div>
              </div>
            </div>

            <div class="col-6 col-md-4">
              <div class="p-3 border rounded-3 bg-light text-center h-100 cursor-pointer hover-card-btn" onclick="switchDashboardTab('ai')">
                <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow-xs" style="width: 44px; height: 44px;">
                  <i class="bi bi-robot fs-5"></i>
                </div>
                <div class="fw-bold text-primary small">AI Assistant</div>
                <div class="text-muted" style="font-size: 0.72rem;">Ask Questions</div>
              </div>
            </div>
          </div>
        </div>

        <!-- AI Health Assistant Quick Banner -->
        <div class="portal-card p-3 p-md-4 mb-4 border-primary border-opacity-25" style="background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 100%);">
          <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
              <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-xs flex-shrink-0" style="width: 44px; height: 44px;">
                <i class="bi bi-robot fs-5"></i>
              </div>
              <div>
                <h5 class="fw-bold text-dark mb-0 fs-6">MediKiosk AI Health Assistant</h5>
                <div class="text-muted small" style="font-size: 0.78rem;">Consult your medicines, lab values, or doctor consultation summaries</div>
              </div>
            </div>
            <a href="/patient/chat" class="btn btn-primary btn-sm rounded-pill shadow-xs px-3 py-2 fw-semibold">
              <i class="bi bi-chat-dots-fill me-1"></i> Open Full Chat
            </a>
          </div>

          <!-- Dynamic Suggestion Chips -->
          <div class="d-flex flex-wrap gap-2 mt-2">
            <% suggestedQuestions.slice(0, 4).forEach(function(sq) { %>
              <a href="/patient/chat?q=<%= encodeURIComponent(sq) %>" class="btn btn-sm btn-white bg-white border text-primary shadow-xs rounded-pill px-3 py-1 fw-medium" style="font-size: 0.8rem;">
                <i class="bi bi-arrow-right-short text-muted"></i> <%= sq %>
              </a>
            <% }); %>
          </div>
        </div>

        <!-- Lab Results Preview -->
        <div class="portal-card p-3 p-md-4">
          <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
            <h5 class="fw-bold text-dark mb-0 fs-6"><i class="bi bi-activity text-danger me-2"></i>Recent Lab Results</h5>
            <button type="button" onclick="switchDashboardTab('reports')" class="btn btn-link btn-sm text-primary p-0 text-decoration-none fw-semibold">
              View All Labs &rarr;
            </button>
          </div>

          <div class="row g-3">
            <% (labResults || []).slice(0, 3).forEach(function(lab) { %>
              <div class="col-md-4">
                <div class="p-3 border rounded-3 bg-white h-100">
                  <div class="text-muted small text-truncate" style="font-size: 0.75rem;"><%= lab.parameter %></div>
                  <div class="fs-4 fw-bold text-dark my-1">
                    <%= lab.value %> <span class="fs-6 fw-normal text-muted"><%= lab.unit %></span>
                  </div>
                  <div class="d-flex align-items-center justify-content-between mt-2">
                    <span class="badge <%= lab.isPotentiallyAbnormal ? 'badge-soft-warning' : 'badge-soft-success' %>" style="font-size: 0.7rem;">
                      <%= lab.status %>
                    </span>
                    <span class="text-muted" style="font-size: 0.68rem;"><%= new Date(lab.reportDate).toLocaleDateString() %></span>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: Digital Card Widget, Notifications, Allergies -->
      <div class="col-lg-4">

        <!-- Card Preview Box -->
        <div class="portal-card p-3 mb-4 text-white cursor-pointer" onclick="switchDashboardTab('card')" style="background: linear-gradient(135deg, #1e3a8a 0%, #0284c7 100%);">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
              <div class="small text-white-50 text-uppercase tracking-wider" style="font-size: 0.68rem;">Hospital Health Card</div>
              <div class="fw-bold fs-5"><%= patientCard.patientName %></div>
            </div>
            <span class="badge bg-white text-dark px-2 py-1 font-monospace" style="font-size: 0.72rem;"><%= patientCard.patientCardNumber %></span>
          </div>

          <div class="row my-2 g-1 small text-white-75">
            <div class="col-6">UHID: <strong class="text-white"><%= patientCard.uhid %></strong></div>
            <div class="col-6">Age/Sex: <strong class="text-white"><%= patientCard.age %> / <%= patientCard.gender %></strong></div>
            <div class="col-6">Blood: <strong class="text-white"><%= patientCard.bloodGroup %></strong></div>
            <div class="col-6">Mobile: <strong class="text-white"><%= patientCard.maskedPhone %></strong></div>
          </div>

          <div class="d-flex align-items-center justify-content-between pt-2 border-top border-white-50 border-opacity-25 mt-2">
            <div class="small text-white-50" style="font-size: 0.7rem;">Tap to open card &rarr;</div>
            <span class="badge bg-light text-primary px-2 py-1">Open Card</span>
          </div>
        </div>

        <!-- Notifications Widget -->
        <div class="portal-card p-3 mb-4">
          <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
            <h6 class="fw-bold mb-0 text-dark small"><i class="bi bi-bell-fill text-warning me-1"></i>Notifications</h6>
            <span class="badge bg-light text-muted border"><%= notifications.length %></span>
          </div>
          <% if (notifications.length > 0) { %>
            <div class="list-group list-group-flush">
              <% notifications.forEach(function(n) { %>
                <div class="list-group-item px-2 py-2 border-0 rounded-2 mb-1 bg-light">
                  <div class="d-flex w-100 justify-content-between align-items-center">
                    <strong class="small text-dark" style="font-size: 0.8rem;"><%= n.title %></strong>
                    <small class="text-muted" style="font-size: 0.68rem;"><%= new Date(n.createdAt).toLocaleDateString() %></small>
                  </div>
                  <p class="mb-0 text-muted small text-truncate" style="font-size: 0.75rem;"><%= n.message %></p>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="text-muted small py-3 text-center">
              <i class="bi bi-check2-circle text-success fs-5 d-block mb-1"></i>
              All caught up! No pending alerts.
            </div>
          <% } %>
        </div>

        <!-- Recorded Allergies -->
        <div class="portal-card p-3">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <h6 class="fw-bold mb-0 text-dark small"><i class="bi bi-shield-exclamation text-danger me-1"></i>Documented Allergies</h6>
          </div>
          <% if (allergies && allergies.hasAllergies) { %>
            <div class="d-flex flex-wrap gap-1">
              <% (allergies.drugAllergies || []).forEach(function(al) { %>
                <span class="badge badge-soft-danger px-2 py-1"><i class="bi bi-exclamation-octagon me-1"></i><%= al %></span>
              <% }); %>
            </div>
          <% } else { %>
            <div class="text-muted small" style="font-size: 0.78rem;">
              <i class="bi bi-check-circle text-success me-1"></i>No Known Drug Allergies (NKDA) reported.
            </div>
          <% } %>
        </div>

      </div>
    </div>

  </div>

  <!-- ======================================================== -->
  <!-- TAB PANE 2: DIGITAL PATIENT HEALTH CARD (IN-PLACE)       -->
  <!-- ======================================================== -->
  <div class="dash-panel-pane" id="pane-card">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">

        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
          <div>
            <h4 class="fw-bold text-dark mb-0 fs-5">Digital Patient Health Card</h4>
            <div class="text-muted small">ABHA & AYUSH Verified Hospital Identity Card</div>
          </div>
          <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-xs">
              <i class="bi bi-printer me-1"></i> Print / Save Card
            </button>
            <button type="button" onclick="switchDashboardTab('overview')" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
              &larr; Back to Overview
            </button>
          </div>
        </div>

        <!-- THE DIGITAL CARD -->
        <!-- FIX: patient card number now lives in data-card-number so the
             barcode script can read it via .dataset instead of splicing
             it into a JS string literal (see script block below). -->
        <div class="portal-card overflow-hidden shadow-sm border-2 border-primary border-opacity-25 mb-4" id="printableDashboardCard" data-card-number="<%= patientCard.patientCardNumber %>">

          <!-- Tricolor Ribbon Strip -->
          <div class="gov-tricolor-bar" style="height: 5px;"></div>

          <!-- Card Header Bar -->
          <div class="p-3 p-md-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0369a1 100%); color: #ffffff;">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <div class="d-flex align-items-center gap-2">
                <div class="bg-white rounded-3 p-1 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                  <img src="/uploads/new_logo.png" alt="Logo" style="max-width: 38px; max-height: 38px; object-fit: contain;">
                </div>
                <div>
                  <div class="fw-bold fs-5 text-white lh-sm">MediKiosk Health Card</div>
                  <small class="text-white-50" style="font-size: 0.75rem;"><%= patientCard.hospitalName %></small>
                </div>
              </div>
              <div class="text-end">
                <span class="badge bg-warning text-dark font-monospace fw-bold px-2 py-1"><%= patientCard.patientCardNumber %></span>
                <div class="text-white-50 mt-1" style="font-size: 0.68rem;">ABDM / AYUSH LINKED</div>
              </div>
            </div>
          </div>

          <!-- Card Body -->
          <div class="p-3 p-md-4 bg-white">
            <div class="row align-items-center g-3">

              <!-- Left Info Column -->
              <div class="col-sm-7">
                <div class="mb-3">
                  <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Patient Full Name</div>
                  <div class="fs-4 fw-bold text-dark"><%= patientCard.patientName %></div>
                </div>

                <div class="row g-2 mb-3">
                  <div class="col-6">
                    <div class="text-muted small" style="font-size: 0.72rem;">UHID Number</div>
                    <div class="font-monospace fw-bold text-primary"><%= patientCard.uhid %></div>
                  </div>
                  <div class="col-6">
                    <div class="text-muted small" style="font-size: 0.72rem;">ABHA ID</div>
                    <div class="font-monospace fw-semibold text-dark"><%= patientCard.abhaId %></div>
                  </div>
                  <div class="col-6">
                    <div class="text-muted small" style="font-size: 0.72rem;">Age / Gender</div>
                    <div class="fw-semibold text-dark"><%= patientCard.age %> Yrs (<%= patientCard.gender %>)</div>
                  </div>
                  <div class="col-6">
                    <div class="text-muted small" style="font-size: 0.72rem;">Blood Group</div>
                    <div class="fw-bold text-danger"><%= patientCard.bloodGroup %></div>
                  </div>
                  <div class="col-6">
                    <div class="text-muted small" style="font-size: 0.72rem;">Registered Phone</div>
                    <div class="font-monospace fw-semibold text-dark"><%= patientCard.maskedPhone %></div>
                  </div>
                  <div class="col-6">
                    <div class="text-muted small" style="font-size: 0.72rem;">Registered On</div>
                    <div class="fw-semibold text-dark"><%= new Date(patientCard.registrationDate).toLocaleDateString() %></div>
                  </div>
                </div>

                <!-- Safe Barcode Component -->
                <div class="mt-3 text-center text-sm-start">
                  <div class="text-muted mb-1" style="font-size: 0.7rem;">Hospital Intake Scanner Barcode:</div>
                  <div class="d-inline-block bg-white p-1 border rounded shadow-xs" style="max-width: 100%;">
                    <img id="dashStaticBarcode" src="<%= patientCard.barcodeData %>" alt="Barcode" class="img-fluid" style="max-height: 46px; max-width: 100%; object-fit: contain;">
                    <svg id="dashDynamicBarcode" class="d-none img-fluid" style="max-height: 46px; max-width: 220px;"></svg>
                  </div>
                  <div class="font-monospace text-muted mt-1 small"><%= patientCard.patientCardNumber %></div>
                </div>
              </div>

              <!-- Right QR Column -->
              <div class="col-sm-5 text-center border-top border-sm-top-0 border-sm-start pt-3 pt-sm-0 ps-sm-3">
                <div class="p-2 border rounded-3 d-inline-block bg-light shadow-xs mb-2">
                  <img src="<%= patientCard.qrCodeData %>" alt="Safe QR Code" style="width: 130px; height: 130px; max-width: 100%; object-fit: contain;">
                </div>
                <div class="small fw-semibold text-dark">Quick Check-in QR</div>
                <div class="text-muted mt-1" style="font-size: 0.72rem;">
                  Scan at any OPD kiosk or reception scanner for instant queueing.
                </div>
              </div>

            </div>
          </div>

          <!-- Card Footer Privacy Notice -->
          <div class="px-3 px-md-4 py-2 bg-light border-top d-flex flex-column flex-sm-row align-items-center justify-content-between gap-2" style="font-size: 0.75rem;">
            <div class="text-muted">
              <i class="bi bi-shield-lock-fill text-success me-1"></i>
              <strong>Privacy-Compliant:</strong> Zero-PHI QR code. Safe identifier only.
            </div>
            <span class="badge bg-secondary-subtle text-secondary font-monospace"><%= patientCard.emergencyContact %></span>
          </div>

        </div>

      </div>
    </div>
