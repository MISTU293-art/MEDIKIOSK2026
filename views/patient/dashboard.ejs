      <button type="button" onclick="switchDashboardTab('overview')" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        &larr; Back to Overview
      </button>
    </div>

    <!-- Visits List -->
    <div class="portal-card p-3 p-md-4 mb-4">
      <h6 class="fw-bold text-dark mb-3"><i class="bi bi-calendar2-heart text-primary me-2"></i>Outpatient Consultations</h6>
      <% if (!visits || visits.length === 0) { %>
        <p class="text-muted small mb-0">No past visits recorded.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
            <thead class="table-light">
              <tr>
                <th>Date</th>
                <th>Department</th>
                <th>Attending Doctor</th>
                <th>Symptoms & Summary</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% visits.forEach(function(v) { %>
                <tr>
                  <td class="text-muted small"><%= new Date(v.date).toLocaleDateString() %></td>
                  <td class="fw-semibold text-dark"><%= v.department %></td>
                  <td><%= v.doctor %></td>
                  <td class="small text-muted" style="max-width: 250px;"><%= v.consultationSummary || v.symptoms %></td>
                  <td><span class="badge bg-success-subtle text-success">Completed</span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Timeline Events -->
    <div class="portal-card p-3 p-md-4">

      <div class="d-flex align-items-center justify-content-between gap-2 mb-3">

        <h6 class="fw-bold text-dark mb-0">
          <i class="bi bi-clock-history text-info me-2"></i>
          Chronological Health Timeline
        </h6>

        <a
          href="/patient/timeline"
          class="btn btn-sm btn-outline-primary"
        >
          <i class="bi bi-clock-history me-1"></i>
          Full Timeline
        </a>

      </div>

      <!--
        FIX: `dashboardTimeline` and `recentTimeline` were previously
        re-declared here with `const`, duplicating the identifiers
        computed at the top of the file. Since EJS compiles the whole
        template into a single function, that raised
        "Identifier 'dashboardTimeline' has already been declared"
        on every request. We now reuse the single top-level
        computation instead of recomputing it.
      -->

      <% if (recentTimeline.length === 0) { %>

        <div class="text-center py-3">

          <i
            class="bi bi-clock-history text-muted d-block mb-2"
            style="font-size: 2rem;"
          ></i>

          <p class="text-muted small mb-0">
            Timeline starts with your first consultation.
          </p>

        </div>

      <% } else { %>

        <div class="border-start border-2 border-primary ps-3 ms-2">

          <% recentTimeline.forEach(function(e) { %>

            <%
              e = e || {};

              const eventTitle =
                e.title ||
                'Medical Event';

              const eventType =
                e.type ||
                'Healthcare Event';

              const eventDescription =
                e.description ||
                '';

              let formattedDate = 'Date unavailable';

              if (e.date) {
                const parsedDate = new Date(e.date);

                if (!isNaN(parsedDate.getTime())) {
                  formattedDate = parsedDate.toLocaleDateString('en-IN', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric'
                  });
                }
              }
            %>


            <!-- TIMELINE EVENT -->
            <div class="mb-3 position-relative">

              <!-- Timeline Node -->
              <span
                class="position-absolute bg-primary rounded-circle"
                style="
                  width: 10px;
                  height: 10px;
                  left: -21px;
                  top: 5px;
                "
              ></span>


              <!-- Event Title -->
              <div class="small fw-bold text-dark">
                <%= eventTitle %>
              </div>


              <!-- Date + Type -->
              <div
                class="text-muted small"
                style="font-size: 0.75rem;"
              >
                <i class="bi bi-calendar3 me-1"></i>

                <%= formattedDate %>

                <span class="mx-1">&bull;</span>

                <%= eventType %>
              </div>


              <!-- Description -->
              <% if (eventDescription) { %>

                <div class="text-muted small mt-1">
                  <%= eventDescription %>
                </div>

              <% } %>

            </div>

          <% }); %>

        </div>


        <% if (dashboardTimeline.length > 5) { %>

          <div class="text-center mt-3">

            <a
              href="/patient/timeline"
              class="btn btn-sm btn-outline-primary"
            >
              <i class="bi bi-arrow-right me-1"></i>
              View <%= dashboardTimeline.length %> Timeline Events
            </a>

          </div>

        <% } %>

      <% } %>

    </div>
  </div>

