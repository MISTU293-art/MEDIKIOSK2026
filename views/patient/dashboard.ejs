        <div class="d-flex gap-2">
          <a href="/patient/chat" class="btn btn-primary btn-sm rounded-pill px-3 shadow-xs">
            <i class="bi bi-arrows-angle-expand me-1"></i> Launch Full Screen Chat
          </a>
          <button type="button" onclick="switchDashboardTab('overview')" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            &larr; Back to Overview
          </button>
        </div>
      </div>

      <p class="text-muted small mb-3">
        Ask questions about your prescribed dosages, laboratory values, previous consultations, or hospital guidance.
      </p>

      <!-- Quick Question Buttons -->
      <div class="d-flex flex-wrap gap-2 mb-3">
        <% suggestedQuestions.forEach(function(sq) { %>
          <a href="/patient/chat?q=<%= encodeURIComponent(sq) %>" class="btn btn-sm btn-white bg-white border text-primary rounded-pill px-3 py-1 shadow-xs fw-medium">
            <i class="bi bi-chat-text text-muted me-1"></i> <%= sq %>
