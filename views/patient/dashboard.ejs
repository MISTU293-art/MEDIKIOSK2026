    </div>
  </div>

</div>

<!-- Client-side Fast Tab Switcher & Dynamic Barcode Fallback -->
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
<script>
  function switchDashboardTab(tabId) {
    if (!tabId) tabId = 'overview';

    // Update pills
    document.querySelectorAll('.dash-tab-pill').forEach(btn => btn.classList.remove('active'));
    const activePill = document.getElementById('pill-' + tabId);
    if (activePill) {
      activePill.classList.add('active');
      activePill.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }

    // Update panes
    document.querySelectorAll('.dash-panel-pane').forEach(pane => pane.classList.remove('active'));
    const targetPane = document.getElementById('pane-' + tabId);
    if (targetPane) {
      targetPane.classList.add('active');
    }

    // Update URL hash without causing a page jump
    if (history.pushState) {
      history.pushState(null, null, '#' + tabId);
    } else {
      location.hash = '#' + tabId;
    }

    // Initialize Barcode if switching to card tab
    if (tabId === 'card') {
      renderDashboardBarcode();
    }
  }

  function renderDashboardBarcode() {
    if (window.JsBarcode) {
      try {
        // FIX: previously `const code = '<%= patientCard.patientCardNumber %>';`
        // spliced server data straight into a JS string literal, which a
        // card number containing a quote/backslash could break out of.
        // Reading it from the data-card-number attribute instead is safe
        // regardless of its contents.
        const cardEl = document.getElementById('printableDashboardCard');
        const code = cardEl ? cardEl.dataset.cardNumber : '';
        if (!code) return;

        JsBarcode('#dashDynamicBarcode', code, {
          format: 'CODE128',
          width: 1.5,
          height: 38,
          displayValue: false,
          margin: 2
        });
        const dyn = document.getElementById('dashDynamicBarcode');
        const stat = document.getElementById('dashStaticBarcode');
        if (dyn && stat) {
          dyn.classList.remove('d-none');
          stat.classList.add('d-none');
        }
      } catch (e) {
        console.warn('JsBarcode dashboard fallback:', e);
      }
    }
  }

  // Handle Initial Hash / Tab Selection on Page Load
  document.addEventListener('DOMContentLoaded', () => {
    const hash = (window.location.hash || '').replace('#', '');
    const urlParams = new URLSearchParams(window.location.search);
    const tabParam = urlParams.get('tab');
    const targetTab = hash || tabParam || 'overview';
    switchDashboardTab(targetTab);
  });

  // Listen to browser Back/Forward navigation
  window.addEventListener('popstate', () => {
    const hash = (window.location.hash || '').replace('#', '');
    if (hash) switchDashboardTab(hash);
  });
</script>

