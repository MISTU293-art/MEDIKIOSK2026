    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
      <div>
        <h4 class="fw-bold text-dark mb-0 fs-5">Active Medicines & Prescriptions</h4>
        <div class="text-muted small">Doctor prescribed regimens, dosages, and administration schedules</div>
      </div>
      <button type="button" onclick="switchDashboardTab('overview')" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        &larr; Back to Overview
      </button>
    </div>

    <% if (!medicines || medicines.length === 0) { %>
      <div class="portal-card p-5 text-center">
        <i class="bi bi-capsule text-muted fs-1 mb-2"></i>
        <h5 class="fw-bold text-dark">No Active Medications Prescribed</h5>
        <p class="text-muted small mb-0">Your doctor has not prescribed any active medications currently.</p>
      </div>
    <% } else { %>
      <div class="row g-3">
        <% medicines.forEach(function(m) { %>
          <div class="col-md-6 col-lg-4">
            <div class="portal-card p-3 h-100 border-start border-4 border-success">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-success-subtle text-success small">Prescribed Medicine</span>
                <span class="text-muted small" style="font-size: 0.72rem;"><%= new Date(m.prescriptionDate || Date.now()).toLocaleDateString() %></span>
              </div>
              <h5 class="fw-bold text-dark mb-1 fs-6"><%= m.medicineName %></h5>
              <div class="small text-muted mb-1">Dosage: <strong><%= m.dosage || 'As directed' %></strong></div>
              <div class="small text-secondary mb-2"><i class="bi bi-clock me-1"></i><%= m.frequency || 'Daily' %> &bull; <%= m.duration || 'Full course' %></div>
              <div class="small text-muted border-top pt-2" style="font-size: 0.75rem;">
                <i class="bi bi-person-badge me-1"></i>Prescribed by: <%= m.prescribedBy || m.doctor || 'Attending Physician' %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- ======================================================== -->
  <!-- TAB PANE 4: REPORTS & LAB RESULTS (IN-PLACE)             -->
  <!-- ======================================================== -->
  <div class="dash-panel-pane" id="pane-reports">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
      <div>
        <h4 class="fw-bold text-dark mb-0 fs-5">Diagnostic Reports & Lab Evaluations</h4>
        <div class="text-muted small">Validated laboratory results, radiology scans, and clinical reviews</div>
      </div>
      <button type="button" onclick="switchDashboardTab('overview')" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        &larr; Back to Overview
      </button>
    </div>

    <!-- Lab Values Table -->
    <% if (labResults && labResults.length > 0) { %>
      <div class="portal-card p-3 p-md-4 mb-4">
        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-activity text-danger me-2"></i>Laboratory Blood & Diagnostic Values</h6>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
            <thead class="table-light">
              <tr>
                <th>Test Parameter</th>
                <th>Measured Value</th>
                <th>Reference Range</th>
                <th>Status</th>
                <th>Report Date</th>
              </tr>
            </thead>
            <tbody>
              <% labResults.forEach(function(lab) { %>
                <tr>
                  <td class="fw-semibold text-dark"><%= lab.parameter %></td>
                  <td class="fw-bold text-primary"><%= lab.value %> <%= lab.unit %></td>
                  <td class="text-muted small"><%= lab.referenceRange || 'Standard' %></td>
                  <td>
                    <span class="badge <%= lab.isPotentiallyAbnormal ? 'bg-warning-subtle text-warning' : 'bg-success-subtle text-success' %>">
                      <%= lab.status %>
                    </span>
                  </td>
                  <td class="text-muted small"><%= new Date(lab.reportDate).toLocaleDateString() %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <!-- Reports Cards -->
    <% if (!reports || reports.length === 0) { %>
      <div class="portal-card p-5 text-center">
        <i class="bi bi-file-earmark-x text-muted fs-1 mb-2"></i>
        <h5 class="fw-bold text-dark">No Uploaded Reports</h5>
        <p class="text-muted small mb-0">Diagnostic reports uploaded by pathology will securely appear here.</p>
      </div>
    <% } else { %>
      <div class="row g-3">
        <% reports.forEach(function(r) { %>
          <div class="col-md-6">
            <div class="portal-card p-3 h-100">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-light text-primary border small"><%= r.reportType %></span>
                <span class="badge <%= r.status === 'reviewed' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' %>">
                  <%= r.statusLabel %>
                </span>
              </div>
              <h5 class="fw-bold text-dark mb-1 fs-6"><%= r.testName %></h5>
              <div class="text-muted small mb-2">
                <i class="bi bi-calendar3 me-1"></i><%= new Date(r.date).toLocaleDateString() %> &bull; Req by: <%= r.requestedBy %>
              </div>
              <% if (r.reviewNotes) { %>
                <div class="small text-muted bg-light p-2 rounded mb-2" style="font-size: 0.78rem;">
                  <i class="bi bi-chat-left-text me-1"></i><%= r.reviewNotes %>
                </div>
              <% } %>
              <div class="pt-2 border-top d-flex gap-2">
                <a href="/patient/chat?q=<%= encodeURIComponent('Explain my ' + r.testName) %>" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1">
                  <i class="bi bi-robot"></i> Explain with AI
                </a>
                <% if (r.downloadUrl) { %>
                  <a href="<%= r.downloadUrl %>" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                    <i class="bi bi-eye"></i> View
                  </a>
                <% } %>
              </div>
            </div>
          </div>
