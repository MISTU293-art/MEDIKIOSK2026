<%- include('header', { title: 'Previous Healthcare Visits — MediKiosk', patient, activeNav: 'visits' }) %>

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h3 class="fw-bold text-dark mb-1">My Healthcare Visits</h3>
      <p class="text-muted small mb-0">Authorized consultation history, department encounters & follow-up instructions</p>
    </div>
    <span class="badge bg-primary fs-6 px-3 py-2"><%= visits.length %> Total Visits</span>
  </div>

  <% if (visits.length === 0) { %>
    <div class="portal-card p-5 text-center">
      <i class="bi bi-calendar-x text-muted fs-1 mb-2"></i>
      <h5 class="fw-bold text-dark">No Previous Visits Recorded</h5>
      <p class="text-muted small mb-3">You do not have any completed outpatient visits yet.</p>
      <a href="/patient/dashboard" class="btn btn-outline-primary btn-sm">Return to Dashboard</a>
    </div>
  <% } else { %>
    <div class="row g-3">
      <% visits.forEach(function(v) { %>
        <div class="col-12">
          <div class="portal-card p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center border-bottom pb-3 mb-3 gap-2">
              <div class="d-flex align-items-center gap-3">
                <div class="bg-primary-subtle text-primary rounded-3 p-2 text-center" style="min-width: 60px;">
                  <div class="fw-bold fs-5 lh-1"><%= new Date(v.date).getDate() %></div>
                  <div class="small text-uppercase" style="font-size: 0.7rem;"><%= new Date(v.date).toLocaleString('default', { month: 'short' }) %></div>
                  <div class="text-muted" style="font-size: 0.68rem;"><%= new Date(v.date).getFullYear() %></div>
                </div>
                <div>
                  <div class="d-flex align-items-center gap-2">
                    <h5 class="fw-bold text-dark mb-0"><%= v.department %></h5>
                    <span class="badge bg-success-subtle text-success text-uppercase" style="font-size: 0.7rem;"><%= v.status %></span>
                  </div>
                  <div class="text-muted small mt-1">
                    <i class="bi bi-person-fill text-primary"></i> <strong><%= v.doctor %></strong> &bull; <%= v.visitNumber %> &bull; <%= v.visitType %>
                  </div>
                </div>
              </div>

              <div class="d-flex align-items-center gap-2">
                <a href="/patient/visits/<%= v.id %>" class="btn btn-primary btn-sm px-3 shadow-xs">
                  <i class="bi bi-eye me-1"></i> View Visit Details
                </a>
              </div>
            </div>

            <!-- Visit Details Row -->
            <div class="row g-3">
              <div class="col-md-6">
                <div class="text-muted small fw-semibold">Chief Complaint / Symptoms:</div>
                <p class="mb-2 text-dark small"><%= v.chiefComplaint || v.symptoms || 'General Checkup' %></p>

                <div class="text-muted small fw-semibold">Diagnosis Recorded by Doctor:</div>
                <p class="mb-0 text-primary fw-semibold small"><%= v.diagnosis || 'Clinical evaluation documented' %></p>
              </div>

              <div class="col-md-6 border-start-md ps-md-4">
                <div class="text-muted small fw-semibold">Doctor Consultation Summary:</div>
                <p class="mb-2 text-dark small"><%= v.consultationSummary %></p>

                <div class="d-flex align-items-center gap-3 mt-2">
                  <span class="badge bg-light text-dark border">
                    <i class="bi bi-prescription text-warning me-1"></i> <%= v.prescriptionsCount %> Medicines
                  </span>
                  <span class="badge bg-light text-dark border">
                    <i class="bi bi-file-earmark-medical text-info me-1"></i> <%= v.reportsCount %> Diagnostics
                  </span>
                  <span class="badge bg-light text-primary border">
                    <i class="bi bi-clock text-primary me-1"></i> <%= v.followUpInstructions %>
                  </span>
                </div>
              </div>
            </div>

          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

</div>

<%- include('footer') %>
