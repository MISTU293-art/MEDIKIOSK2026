<%- include('header', { title: 'My Profile — MediKiosk', patient, activeNav: 'profile' }) %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      
      <div class="portal-card p-4 mb-4">
        <div class="d-flex align-items-center gap-3 border-bottom pb-3 mb-3">
          <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-3" style="width: 60px; height: 60px;">
            <%= (profile.fullName || 'P').charAt(0).toUpperCase() %>
          </div>
          <div>
            <h4 class="fw-bold text-dark mb-1"><%= profile.fullName %></h4>
            <div class="text-muted small">
              UHID: <span class="font-monospace fw-bold text-primary"><%= profile.uhid %></span> &bull; Card: <%= profile.cardNumber %>
            </div>
          </div>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label class="form-label text-muted small fw-semibold">Age & Gender</label>
            <div class="fw-semibold text-dark"><%= profile.age %> Years (<%= profile.gender %>)</div>
          </div>
          <div class="col-md-6">
            <label class="form-label text-muted small fw-semibold">Registered Mobile Number</label>
            <div class="fw-semibold text-dark"><%= profile.maskedPhone %></div>
          </div>
          <div class="col-md-6">
            <label class="form-label text-muted small fw-semibold">Primary Department</label>
            <div class="fw-semibold text-dark"><%= profile.department %></div>
          </div>
          <div class="col-md-6">
            <label class="form-label text-muted small fw-semibold">Emergency Contact</label>
            <div class="fw-semibold text-dark"><%= profile.emergencyContact %></div>
          </div>
          <div class="col-md-6">
            <label class="form-label text-muted small fw-semibold">ABHA Address / ID</label>
            <div class="fw-semibold text-dark"><%= profile.abhaId || 'ABHA Ready' %></div>
          </div>
          <div class="col-md-6">
            <label class="form-label text-muted small fw-semibold">Ayushman Scheme Type</label>
            <div class="fw-semibold text-dark"><%= profile.ayushmanSchemeType || 'PM-JAY Golden Card' %></div>
          </div>
        </div>

        <!-- Language Preference (Section 66) -->
        <div class="p-3 bg-light rounded-3 border">
          <h6 class="fw-bold text-dark mb-2"><i class="bi bi-translate text-primary me-2"></i>Preferred Language for AI Assistant</h6>
          <p class="text-muted small mb-3">Select your preferred language for the AI Health Assistant and clinical summary translations.</p>
          <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-sm <%= profile.preferredLanguage === 'en' ? 'btn-primary' : 'btn-outline-secondary' %>" onclick="updateLang('en')">English</button>
            <button class="btn btn-sm <%= profile.preferredLanguage === 'hi' ? 'btn-primary' : 'btn-outline-secondary' %>" onclick="updateLang('hi')">हिंदी (Hindi)</button>
            <button class="btn btn-sm <%= profile.preferredLanguage === 'bn' ? 'btn-primary' : 'btn-outline-secondary' %>" onclick="updateLang('bn')">বাংলা (Bengali)</button>
          </div>
        </div>

      </div>

      <div class="d-flex justify-content-between align-items-center">
        <a href="/patient/dashboard" class="btn btn-outline-secondary btn-sm">&larr; Return to Dashboard</a>
        <a href="/patient/logout" class="btn btn-danger btn-sm"><i class="bi bi-box-arrow-right me-1"></i> Logout of Patient Portal</a>
      </div>

    </div>
  </div>
</div>

<script>
  async function updateLang(lang) {
    try {
      const res = await fetch('/api/patient/me/language', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ language: lang })
      });
      const data = await res.json();
      if (data.success) {
        alert('Language preference updated to ' + lang.toUpperCase());
        window.location.reload();
      }
    } catch (e) {
      alert('Error updating language preference.');
    }
  }
</script>

<%- include('footer') %>
