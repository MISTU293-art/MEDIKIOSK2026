<%- include('header', { title: 'My Medical Documents — MediKiosk', patient, activeNav: 'documents' }) %>

<div class="container py-4">
  <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
    <div>
      <h3 class="fw-bold text-dark mb-1">My Medical Documents</h3>
      <p class="text-muted small mb-0">Uploaded prescriptions, clinical scans, discharge summaries, and OCR extractions</p>
    </div>
    <button class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#uploadDocModal">
      <i class="bi bi-cloud-arrow-up"></i> Upload Medical Document
    </button>
  </div>

  <% if (documents.length === 0) { %>
    <div class="portal-card p-5 text-center">
      <i class="bi bi-folder-x text-muted fs-1 mb-2"></i>
      <h5 class="fw-bold text-dark">No Documents Uploaded</h5>
      <p class="text-muted small mb-3">Upload your external medical records or paper prescriptions for automated OCR processing.</p>
      <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#uploadDocModal">
        Upload Your First Record
      </button>
    </div>
  <% } else { %>
    <div class="row g-3">
      <% documents.forEach(function(doc) { %>
        <div class="col-md-6">
          <div class="portal-card p-4 h-100 d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-secondary-subtle text-secondary"><%= doc.docType %></span>
                <% if (doc.isMachineGenerated) { %>
                  <span class="badge bg-warning-subtle text-warning-emphasis border border-warning" style="font-size: 0.7rem;">
                    <i class="bi bi-cpu me-1"></i>Machine-Generated (OCR)
                  </span>
                <% } else { %>
                  <span class="badge bg-success-subtle text-success" style="font-size: 0.7rem;">
                    <i class="bi bi-patch-check-fill me-1"></i>Clinically Verified
                  </span>
                <% } %>
              </div>

              <h5 class="fw-bold text-dark mb-1 text-truncate" title="<%= doc.fileName %>">
                <i class="bi bi-file-earmark-pdf text-danger me-1"></i><%= doc.fileName %>
              </h5>
              
              <div class="text-muted small mb-3">
                <%= new Date(doc.documentDate).toLocaleDateString() %> &bull; Size: <%= doc.fileSize %> &bull; Type: <%= doc.mimeType %>
              </div>

              <div class="p-3 bg-light rounded-3 mb-3 border small">
                <div class="text-muted fw-semibold mb-1">Document Intelligence Status:</div>
                <div class="text-secondary"><%= doc.verificationNote %></div>
                <% if (doc.rawOcrText) { %>
                  <div class="mt-2 text-dark font-monospace text-truncate" style="font-size: 0.72rem;">
                    OCR: "<%= doc.rawOcrText.slice(0, 80) %>..."
                  </div>
                <% } %>
              </div>
            </div>

            <div class="pt-3 border-top d-flex align-items-center justify-content-between">
              <span class="text-muted small" style="font-size: 0.75rem;">Status: <%= doc.ocrStatus %></span>
              <div class="d-flex gap-2">
                <a href="<%= doc.fileUrl %>" class="btn btn-sm btn-outline-secondary" target="_blank">
                  <i class="bi bi-eye"></i> View
                </a>
                <a href="<%= doc.fileUrl %>" class="btn btn-sm btn-primary" download>
                  <i class="bi bi-download"></i> Download
                </a>
              </div>
            </div>

          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- Notice Section 54 -->
  <div class="mt-4 p-3 bg-white border rounded-3 text-muted small d-flex align-items-center gap-2">
    <i class="bi bi-shield-check text-primary fs-5"></i>
    <div>
      <strong>Document Integrity:</strong> OCR-extracted medical information remains strictly marked as machine-generated until verified by hospital staff or attending doctors.
    </div>
  </div>
</div>

<!-- Modal: Upload Medical Document -->
<div class="modal fade" id="uploadDocModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">Upload Medical Document</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="uploadDocForm">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Document Category *</label>
            <select class="form-select" id="docCategory" required>
              <option value="Prescription">Previous Prescription</option>
              <option value="Lab Report">Lab Report</option>
              <option value="Scan Report">Scan / Radiology Report (X-Ray, MRI, CT)</option>
              <option value="Discharge Summary">Discharge Summary</option>
              <option value="Medical Certificate">Medical Certificate</option>
              <option value="Other">Other Clinical Document</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Document Title / Name *</label>
            <input type="text" class="form-control" id="docName" placeholder="e.g. Previous_Cardio_Prescription_2025.pdf" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Notes / Description (Optional)</label>
            <textarea class="form-control" rows="2" id="docNotes" placeholder="e.g. Uploaded from previous hospital visit"></textarea>
          </div>

          <div class="p-3 bg-light rounded-3 border text-center">
            <i class="bi bi-cloud-arrow-up text-primary fs-2 d-block mb-1"></i>
            <span class="small text-muted">Document will be encrypted and indexed by MediKiosk Document Intelligence.</span>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" onclick="submitDocUpload()">Upload & Index Record</button>
      </div>
    </div>
  </div>
</div>

<script>
  async function submitDocUpload() {
    const docName = document.getElementById('docName').value.trim();
    const docCategory = document.getElementById('docCategory').value;
    const notes = document.getElementById('docNotes').value.trim();

    if (!docName) {
      alert('Please specify a document name.');
      return;
    }

    try {
      const res = await fetch('/api/patient/me/documents/upload', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ originalName: docName, docType: docCategory, notes })
      });
      const data = await res.json();
      if (data.success) {
        alert('Document uploaded successfully!');
        window.location.reload();
      } else {
        alert('Upload failed: ' + (data.error || 'Server error'));
      }
    } catch (e) {
      alert('Network error uploading document.');
    }
  }
</script>

<%- include('footer') %>
