<%- include('header', { title: 'Patient Login — MediKiosk Health Portal', patient: null }) %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
      <div class="portal-card p-4 p-md-5">
        
        <div class="text-center mb-4">
          <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 52px; height: 52px;">
            <i class="bi bi-shield-lock-fill fs-3"></i>
          </div>
          <h3 class="fw-bold text-dark mb-1">Patient Portal Login</h3>
          <p class="text-muted small">Access your personal healthcare records, digital card & AI assistant</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div><%= error %></div>
          </div>
        <% } %>

        <% if (typeof logged_out !== 'undefined' && logged_out) { %>
          <div class="alert alert-success py-2 px-3 small d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>You have been safely logged out. Your session is cleared.</div>
          </div>
        <% } %>

        <% if (typeof expired !== 'undefined' && expired) { %>
          <div class="alert alert-warning py-2 px-3 small d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-clock-history"></i>
            <div>Your session has expired. Please log in again to continue.</div>
          </div>
        <% } %>

        <form action="/patient/login" method="POST">
          <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '' %>">
          
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Mobile No. / Email / UHID / Card No.</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="bi bi-person-fill text-muted"></i></span>
              <input type="text" name="identifier" class="form-control" placeholder="e.g. 9830112233 or UHID-880124-12" required autofocus>
            </div>
            <div class="form-text" style="font-size: 0.78rem;">Use your registered 10-digit mobile number, email, or UHID.</div>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-semibold text-secondary">Password</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="bi bi-key-fill text-muted"></i></span>
              <input type="password" name="password" id="patientPassword" class="form-control" placeholder="••••••••" required>
              <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility()">
                <i class="bi bi-eye" id="toggleIcon"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mb-3">
            <i class="bi bi-box-arrow-in-right me-1"></i> Secure Patient Login
          </button>
        </form>

        <div class="text-center mb-4">
          <span class="text-muted small">New patient or need an account?</span>
          <a href="/patient/register" class="text-decoration-none fw-semibold small ms-1 text-primary">Register Here</a>
        </div>

        <!-- Quick 1-Click Demo Logins for Instant Testing -->
        <div class="border-top pt-3 mt-3">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="badge bg-secondary-subtle text-dark fw-normal" style="font-size: 0.75rem;">1-Click Evaluator Demo Access</span>
            <span class="text-muted" style="font-size: 0.72rem;">Default: patient123</span>
          </div>

          <div class="d-grid gap-2">
            <form action="/patient/quick-demo-login" method="POST">
              <input type="hidden" name="demoType" value="rajesh">
              <button type="submit" class="btn btn-sm btn-outline-primary w-100 text-start d-flex align-items-center justify-content-between">
                <div>
                  <strong class="d-block">Rajesh Kumar Chatterjee (58M)</strong>
                  <span class="small text-muted" style="font-size: 0.72rem;">UHID: UHID-880124-12 | Mob: 9830112233</span>
                </div>
                <i class="bi bi-chevron-right text-primary"></i>
              </button>
            </form>

            <form action="/patient/quick-demo-login" method="POST">
              <input type="hidden" name="demoType" value="sunita">
              <button type="submit" class="btn btn-sm btn-outline-secondary w-100 text-start d-flex align-items-center justify-content-between">
                <div>
                  <strong class="d-block">Sunita Devi Sharma (42F)</strong>
                  <span class="small text-muted" style="font-size: 0.72rem;">UHID: UHID-880124-15 | Mob: 9876543210</span>
                </div>
                <i class="bi bi-chevron-right"></i>
              </button>
            </form>
          </div>
        </div>

        <!-- Security Disclaimers (Section 44) -->
        <div class="mt-4 pt-3 border-top text-center text-muted" style="font-size: 0.75rem;">
          <div class="d-flex justify-content-center gap-3 mb-1">
            <span><i class="bi bi-shield-check text-success"></i> HTTP-only Secure Cookies</span>
            <span><i class="bi bi-lock text-primary"></i> Bcrypt Salted Hash</span>
            <span><i class="bi bi-stopwatch text-warning"></i> Rate Limited</span>
          </div>
          <div>Strict server-side authorization ensures patients access strictly their own clinical data.</div>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
  function togglePasswordVisibility() {
    const input = document.getElementById('patientPassword');
    const icon = document.getElementById('toggleIcon');
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'bi bi-eye-slash';
    } else {
      input.type = 'password';
      icon.className = 'bi bi-eye';
    }
  }
</script>

<%- include('footer') %>
