<%- include('header', { title: 'Digital Patient Card — MediKiosk', patient, activeNav: 'card' }) %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">

      <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
          <h4 class="fw-bold text-dark mb-0">My Patient Card</h4>
          <p class="text-muted small mb-0">Official Digital Health Card for hospital identification & check-in</p>
        </div>
        <button onclick="window.print()" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
          <i class="bi bi-printer"></i> Print / Save Card
        </button>
      </div>

      <!-- DIGITAL CARD CONTAINER -->
      <div class="portal-card overflow-hidden shadow-lg border-2 border-primary border-opacity-25" id="printableCard">
        
        <!-- Card Header with Tricolor Strip -->
        <div style="height: 5px; background: linear-gradient(90deg, #FF9933 33.3%, #FFFFFF 33.3%, #FFFFFF 66.6%, #138808 66.6%);"></div>
        
        <div class="p-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0369a1 100%); color: #ffffff;">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
              <div class="bg-white rounded-3 p-1 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                <img src="/uploads/new_logo.png" alt="Logo" style="max-width: 38px; max-height: 38px; object-fit: contain;">
              </div>
              <div>
                <div class="fw-bold fs-5 tracking-wide text-white lh-sm">MediKiosk Health Card</div>
                <small class="text-white-50" style="font-size: 0.75rem;"><%= card.hospitalName %></small>
              </div>
            </div>
            <div class="text-end">
              <span class="badge bg-warning text-dark font-monospace fw-bold px-2 py-1"><%= card.patientCardNumber %></span>
              <div class="text-white-50 mt-1" style="font-size: 0.68rem;">ABHA LINKED</div>
            </div>
          </div>
        </div>

        <!-- Card Body -->
        <div class="p-4 bg-white">
          <div class="row align-items-center g-4">
            
            <!-- Left Info Column -->
            <div class="col-sm-7">
              <div class="mb-3">
                <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Patient Full Name</div>
                <div class="fs-4 fw-bold text-dark"><%= card.patientName %></div>
              </div>

              <div class="row g-2 mb-3">
                <div class="col-6">
                  <div class="text-muted small" style="font-size: 0.72rem;">Universal Health ID (UHID)</div>
                  <div class="font-monospace fw-bold text-primary"><%= card.uhid %></div>
                </div>
                <div class="col-6">
                  <div class="text-muted small" style="font-size: 0.72rem;">ABHA ID</div>
                  <div class="font-monospace fw-semibold text-dark"><%= card.abhaId %></div>
                </div>
                <div class="col-6">
                  <div class="text-muted small" style="font-size: 0.72rem;">Date of Birth / Age</div>
                  <div class="fw-semibold text-dark"><%= card.age %> Years (<%= card.gender %>)</div>
                </div>
                <div class="col-6">
                  <div class="text-muted small" style="font-size: 0.72rem;">Blood Group</div>
                  <div class="fw-bold text-danger"><%= card.bloodGroup %></div>
                </div>
                <div class="col-6">
                  <div class="text-muted small" style="font-size: 0.72rem;">Registered Mobile</div>
                  <div class="font-monospace fw-semibold text-dark"><%= card.maskedPhone %></div>
                </div>
                <div class="col-6">
                  <div class="text-muted small" style="font-size: 0.72rem;">Registration Date</div>
                  <div class="fw-semibold text-dark"><%= new Date(card.registrationDate).toLocaleDateString() %></div>
                </div>
              </div>

              <!-- Barcode SVG Safe representation -->
              <div class="mt-3 text-center text-sm-start">
                <div class="text-muted mb-1" style="font-size: 0.7rem;">Hospital Intake Scanner Barcode:</div>
                <div class="d-inline-block bg-white p-1 border rounded shadow-xs" style="max-width: 100%;">
                  <img id="staticBarcodeImg" src="<%= card.barcodeData %>" alt="Barcode" class="img-fluid" style="max-height: 48px; max-width: 100%; object-fit: contain;">
                  <svg id="dynamicBarcode" class="d-none img-fluid" style="max-height: 48px; max-width: 220px;"></svg>
                </div>
                <div class="font-monospace text-muted mt-1 small"><%= card.patientCardNumber %></div>
              </div>
            </div>

            <!-- Right QR Column -->
            <div class="col-sm-5 text-center border-top border-sm-top-0 border-sm-start pt-3 pt-sm-0 ps-sm-4">
              <div class="p-2 border rounded-3 d-inline-block bg-light shadow-xs mb-2">
                <img src="<%= card.qrCodeData %>" alt="Safe QR Code" style="width: 130px; height: 130px; max-width: 100%; object-fit: contain;">
              </div>
              <div class="small fw-semibold text-dark">Secure Check-in QR</div>
              <div class="text-muted mt-1" style="font-size: 0.72rem;">
                Scan at any MediKiosk terminal for quick clinical intake queueing.
              </div>
            </div>

          </div>
        </div>

        <!-- Card Footer & Security Compliance Notice -->
        <div class="px-4 py-3 bg-light border-top d-flex flex-column flex-sm-row align-items-center justify-content-between gap-2" style="font-size: 0.75rem;">
          <div class="text-muted">
            <i class="bi bi-shield-lock-fill text-success me-1"></i>
            <strong>Privacy Rule:</strong> This QR & barcode contain ONLY a safe identifier. Never diagnostics, Aadhaar or medicines.
          </div>
          <span class="badge bg-secondary-subtle text-secondary font-monospace"><%= card.emergencyContact %></span>
        </div>

      </div>

      <!-- Info Box below Card -->
      <div class="mt-4 p-3 bg-white rounded-3 border">
        <h6 class="fw-bold text-dark mb-1"><i class="bi bi-info-circle-fill text-primary me-2"></i>How to use your MediKiosk Card:</h6>
        <p class="small text-muted mb-0">
          Present this digital card on your mobile phone or physical printout at any MediKiosk touch terminal in the hospital lobby. The terminal scanner will securely detect your UHID, bypass repetitive demographic registration, and immediately queue you for clinical assessment.
        </p>
      </div>

    </div>
  </div>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
<script>
  if (window.JsBarcode) {
    try {
      const code = '<%= card.patientCardNumber %>';
      JsBarcode('#dynamicBarcode', code, {
        format: 'CODE128',
        width: 1.5,
        height: 38,
        displayValue: false,
        margin: 2
      });
      const dyn = document.getElementById('dynamicBarcode');
      const stat = document.getElementById('staticBarcodeImg');
      if (dyn && stat) {
        dyn.classList.remove('d-none');
        stat.classList.add('d-none');
      }
    } catch(err) {
      console.warn('JsBarcode fallback active:', err);
    }
  }
</script>

<%- include('footer') %>
