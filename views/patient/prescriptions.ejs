<%- include('header', { title: 'Prescriptions — MediKiosk', patient, activeNav: 'prescriptions' }) %>

<div class="container py-4">
  <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
    <div>
      <h3 class="fw-bold text-dark mb-1">Prescription History</h3>
      <p class="text-muted small mb-0">Authorized medications prescribed by hospital physicians & specialists</p>
    </div>
    <a href="/patient/medicines" class="btn btn-outline-success btn-sm d-flex align-items-center gap-1">
      <i class="bi bi-capsule"></i> Go to Medicine Timeline
    </a>
  </div>

  <% if (prescriptions.length === 0) { %>
    <div class="portal-card p-5 text-center">
      <i class="bi bi-prescription text-muted fs-1 mb-2"></i>
      <h5 class="fw-bold text-dark">No Prescriptions Recorded</h5>
      <p class="text-muted small">New prescriptions generated by doctors will automatically appear here.</p>
    </div>
  <% } else { %>
    <div class="row g-3">
      <% prescriptions.forEach(function(rx) { %>
        <div class="col-md-6">
          <div class="portal-card p-4 h-100 d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-primary-subtle text-primary fw-semibold"><%= rx.department || 'Outpatient Clinic' %></span>
                <span class="badge bg-success-subtle text-success text-uppercase" style="font-size: 0.72rem;"><%= rx.status %></span>
              </div>

              <h5 class="fw-bold text-dark mb-1"><%= rx.medicineName %></h5>
              <div class="text-muted small mb-3">
                <i class="bi bi-person-fill text-secondary"></i> Prescribed by: <strong><%= rx.doctor %></strong> &bull; <%= new Date(rx.prescriptionDate).toLocaleDateString() %>
              </div>

              <div class="bg-light p-3 rounded-3 mb-3 border">
                <div class="row g-2 small">
                  <div class="col-6">
                    <span class="text-muted d-block" style="font-size: 0.75rem;">Dosage:</span>
                    <strong><%= rx.dosage %></strong>
                  </div>
                  <div class="col-6">
                    <span class="text-muted d-block" style="font-size: 0.75rem;">Frequency:</span>
                    <strong><%= rx.frequency %></strong>
                  </div>
                  <div class="col-6 mt-2">
                    <span class="text-muted d-block" style="font-size: 0.75rem;">Duration:</span>
                    <strong class="text-primary"><%= rx.duration %></strong>
                  </div>
                  <div class="col-6 mt-2">
                    <span class="text-muted d-block" style="font-size: 0.75rem;">Status:</span>
                    <strong class="text-success">Active Regimen</strong>
                  </div>
                </div>
              </div>

              <% if (rx.instructions) { %>
                <div class="small text-secondary mb-3">
                  <i class="bi bi-info-circle-fill text-primary me-1"></i>
                  <strong>Instructions:</strong> <%= rx.instructions %>
                </div>
              <% } %>
            </div>

            <div class="pt-3 border-top d-flex align-items-center justify-content-between">
              <a href="/patient/chat?q=<%= encodeURIComponent('How should I take ' + rx.medicineName + '?') %>" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-robot me-1"></i> Ask AI Assistant
              </a>
              <span class="text-muted small" style="font-size: 0.75rem;">ID: <%= rx.id.slice(0, 15) %></span>
            </div>

          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

</div>

<%- include('footer') %>
