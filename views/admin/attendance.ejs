<%- include('../partials/header') %><div class="app-layout-wrapper"><%- include('../partials/sidebar') %><div class="main-content-wrapper"><%- include('../partials/topbar') %><main class="p-4"><h2 class="fw-bold">Staff Attendance</h2><p class="text-muted">Server-derived clock in/out event history.</p><div class="card border-0 shadow-sm p-4"><div class="table-responsive"><table class="table table-gov"><thead><tr><th>Staff</th><th>Action</th><th>Time</th><th>Terminal</th></tr></thead><tbody><% records.forEach(record => { const member = users.find(item => String(item._id) === record.userId); %><tr><td><%= member ? member.name : record.userId %></td><td><span class="badge bg-<%= record.action === 'in' ? 'success' : 'secondary' %>"><%= record.action.toUpperCase() %></span></td><td><%= new Date(record.timestamp).toLocaleString() %></td><td><%= record.terminalId || 'N/A' %></td></tr><% }) %></tbody></table></div></div></main></div></div><%- include('../partials/footer') %>