<%- include('../partials/header') %>
<main class="container py-4"><div class="card shadow-lg border-0 mx-auto" style="max-width:520px"><div class="gov-tricolor-bar"></div><div class="p-4 text-center"><div class="text-uppercase text-muted small fw-bold">MediKiosk Hospital Staff Identity</div><h2 class="fw-bold mt-3"><%= member.name %></h2><div class="badge bg-primary fs-6"><%= member.role %></div><p class="text-muted mt-2 mb-1"><%= member.department || 'Hospital Operations' %></p><p class="small text-muted">Issued: <%= new Date(card.createdAt).toLocaleDateString() %></p><canvas id="staffQr" width="160" height="160" aria-label="Staff card QR code"></canvas><div class="font-monospace small mt-2"><%= card.cardId %></div><p class="small text-muted mt-3">QR payload contains only this opaque card identifier.</p><button class="btn btn-primary d-print-none" onclick="window.print()"><i class="bi bi-printer me-1"></i> Print ID Card</button></div></div></main><script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script><script>if(window.QRCode)QRCode.toCanvas(document.getElementById('staffQr'),'<%= card.cardId %>',{width:160,margin:2});</script><%- include('../partials/footer') %>