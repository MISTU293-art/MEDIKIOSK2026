<%- include('../partials/header') %>
<div class="app-layout-wrapper">
  <%- include('../partials/sidebar') %>
  <div class="main-content-wrapper">
    <%- include('../partials/topbar') %>
    <main class="p-4">
      
      <!-- Settings Header -->
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
          <div class="d-flex align-items-center gap-2">
            <div class="bg-primary text-white p-2 rounded-3 shadow-sm">
              <i class="bi bi-sliders fs-4"></i>
            </div>
            <div>
              <h2 class="fw-bold m-0 text-dark">Institutional & Cloud AI Master Configuration</h2>
              <p class="text-muted m-0 small">Facility Network &bull; MedLLM Inference Engine &bull; ImageKit.io CDN &bull; ABDM Sandbox &bull; DPDP Compliance</p>
            </div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2 rounded-pill fw-semibold">
            <i class="bi bi-shield-lock-fill me-1"></i> Superadmin Master Access
          </span>
        </div>
      </div>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 mb-4 shadow-sm" role="alert">
          <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i> <strong>Settings Updated!</strong> All backend parameters, AI models, and facility credentials were saved successfully.
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <form action="/admin/settings" method="POST">
        
        <!-- Navigation Pills for Backend Settings Categories -->
        <ul class="nav nav-pills mb-4 p-2 bg-white rounded-4 border shadow-sm" id="settingsTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill fw-bold" id="facility-tab" data-bs-toggle="pill" data-bs-target="#facility-pane" type="button" role="tab">
              <i class="bi bi-hospital me-1 text-primary"></i> 1. Facility & State Network
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold" id="ai-tab" data-bs-toggle="pill" data-bs-target="#ai-pane" type="button" role="tab">
              <i class="bi bi-robot me-1 text-purple"></i> 2. MedLLM & Clinical AI
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold" id="imagekit-tab" data-bs-toggle="pill" data-bs-target="#imagekit-pane" type="button" role="tab">
              <i class="bi bi-cloud-arrow-up-fill me-1 text-info"></i> 3. ImageKit.io & Cloud OCR
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold" id="kiosk-tab" data-bs-toggle="pill" data-bs-target="#kiosk-pane" type="button" role="tab">
              <i class="bi bi-mic-fill me-1 text-warning"></i> 4. Voice & Regional Languages
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold" id="compliance-tab" data-bs-toggle="pill" data-bs-target="#compliance-pane" type="button" role="tab">
              <i class="bi bi-shield-check me-1 text-success"></i> 5. ABDM & DPDP Compliance
            </button>
          </li>
        </ul>

        <div class="tab-content" id="settingsTabsContent">
          
          <!-- TAB 1: Facility & State Network -->
          <div class="tab-pane fade show active" id="facility-pane" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white mb-4 border-start border-primary border-4">
              <h5 class="fw-bold text-primary mb-3"><i class="bi bi-geo-alt-fill me-2"></i>Healthcare Facility Profile & National Registry (HFR)</h5>
              
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Hospital / Institutional Name *</label>
                  <input type="text" name="hospital_name" class="form-control" value="<%= settings.hospital_name %>" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Facility Classification Level *</label>
                  <select name="facility_type" class="form-select">
                    <option value="National AYUSH Institute & Tertiary Hospital" <%= settings.facility_type === 'National AYUSH Institute & Tertiary Hospital' ? 'selected' : '' %>>National AYUSH Institute & Tertiary Hospital</option>
                    <option value="State AYUSH Medical College Hospital" <%= settings.facility_type === 'State AYUSH Medical College Hospital' ? 'selected' : '' %>>State AYUSH Medical College Hospital</option>
                    <option value="District Integrated Hospital (AYUSH Wing)" <%= settings.facility_type === 'District Integrated Hospital (AYUSH Wing)' ? 'selected' : '' %>>District Integrated Hospital (AYUSH Wing)</option>
                    <option value="Ayush Health & Wellness Centre (AHWC)" <%= settings.facility_type === 'Ayush Health & Wellness Centre (AHWC)' ? 'selected' : '' %>>Ayush Health & Wellness Centre (AHWC)</option>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label fw-semibold small">State / Union Territory *</label>
                  <select name="state" class="form-select">
                    <option value="Delhi (National Capital Territory)" <%= settings.state === 'Delhi (National Capital Territory)' ? 'selected' : '' %>>Delhi (NCT)</option>
                    <option value="Maharashtra" <%= settings.state === 'Maharashtra' ? 'selected' : '' %>>Maharashtra</option>
                    <option value="West Bengal" <%= settings.state === 'West Bengal' ? 'selected' : '' %>>West Bengal</option>
                    <option value="Tamil Nadu" <%= settings.state === 'Tamil Nadu' ? 'selected' : '' %>>Tamil Nadu</option>
                    <option value="Uttar Pradesh" <%= settings.state === 'Uttar Pradesh' ? 'selected' : '' %>>Uttar Pradesh</option>
                    <option value="Gujarat" <%= settings.state === 'Gujarat' ? 'selected' : '' %>>Gujarat</option>
                    <option value="Karnataka" <%= settings.state === 'Karnataka' ? 'selected' : '' %>>Karnataka</option>
                    <option value="Kerala" <%= settings.state === 'Kerala' ? 'selected' : '' %>>Kerala</option>
                    <option value="Rajasthan" <%= settings.state === 'Rajasthan' ? 'selected' : '' %>>Rajasthan</option>
                    <option value="Pan-India Multi-State Gateway" <%= settings.state === 'Pan-India Multi-State Gateway' ? 'selected' : '' %>>Pan-India Multi-State Gateway</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label fw-semibold small">Administrative District</label>
                  <input type="text" name="district" class="form-control" value="<%= settings.district %>">
                </div>
                <div class="col-md-4">
                  <label class="form-label fw-semibold small">National HFR Registry ID</label>
                  <input type="text" name="hfr_id" class="form-control font-monospace" value="<%= settings.hfr_id %>">
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Daily OPD Intake Quota Capacity</label>
                  <input type="number" name="opd_daily_quota" class="form-control" value="<%= settings.opd_daily_quota %>">
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Hospital In-Patient Bed Capacity</label>
                  <input type="number" name="bed_capacity" class="form-control" value="<%= settings.bed_capacity %>">
                </div>
              </div>
            </div>
          </div>

          <!-- TAB 2: MedLLM & Clinical AI Parameters -->
          <div class="tab-pane fade" id="ai-pane" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white mb-4 border-start border-purple border-4">
              <h5 class="fw-bold text-purple mb-3"><i class="bi bi-cpu-fill me-2"></i>Clinical MedLLM Inference Engine & Safety Gates</h5>
              
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Primary AI Model Engine:</label>
                  <select name="ai_model_provider" class="form-select">
                    <option value="gemini-1.5-flash" <%= settings.ai_model_provider === 'gemini-1.5-flash' ? 'selected' : '' %>>Google Gemini 1.5 Flash (Ultra-Fast Response)</option>
                    <option value="gemini-1.5-pro" <%= settings.ai_model_provider === 'gemini-1.5-pro' ? 'selected' : '' %>>Google Gemini 1.5 Pro (Deep Clinical Reasoning)</option>
                    <option value="local-medllm" <%= settings.ai_model_provider === 'local-medllm' ? 'selected' : '' %>>Local Hospital On-Premise MedLLM</option>
                  </select>
                </div>
                <div class="col-md-3">
                  <label class="form-label fw-semibold small">Temperature (0.0 = Deterministic):</label>
                  <input type="number" step="0.1" name="ai_temperature" class="form-control" value="<%= settings.ai_temperature %>" min="0.0" max="1.0">
                </div>
                <div class="col-md-3">
                  <label class="form-label fw-semibold small">Max Token Limit:</label>
                  <input type="number" name="ai_max_tokens" class="form-control" value="<%= settings.ai_max_tokens %>">
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Emergency Red-Flag Sensitivity:</label>
                  <select name="red_flag_sensitivity" class="form-select">
                    <option value="high" <%= settings.red_flag_sensitivity === 'high' ? 'selected' : '' %>>High Sensitivity (Stat Critical Care Escalation)</option>
                    <option value="balanced" <%= settings.red_flag_sensitivity === 'balanced' ? 'selected' : '' %>>Balanced Clinical Triage</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Pharmacy Drug-Allergy Safety Shield:</label>
                  <select name="allergy_shield_mode" class="form-select">
                    <option value="block_dispensation" <%= settings.allergy_shield_mode === 'block_dispensation' ? 'selected' : '' %>>Block Dispensation on Severe Contraindication</option>
                    <option value="warning_only" <%= settings.allergy_shield_mode === 'warning_only' ? 'selected' : '' %>>Warning & Advisory Confirmation Mode</option>
                  </select>
                </div>

                <div class="col-12">
                  <label class="form-label fw-semibold small">Mandatory Non-Diagnostic Disclaimer Text:</label>
                  <textarea name="custom_disclaimer" class="form-control small font-monospace" rows="2"><%= settings.custom_disclaimer %></textarea>
                </div>
              </div>
            </div>
          </div>

          <!-- TAB 3: ImageKit.io & Cloud OCR -->
          <div class="tab-pane fade" id="imagekit-pane" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white mb-4 border-start border-info border-4">
              <h5 class="fw-bold text-info mb-3"><i class="bi bi-cloud-arrow-up-fill me-2"></i>ImageKit.io CDN & Medical Image OCR Pipeline</h5>
              
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">ImageKit Public API Key:</label>
                  <input type="text" name="imagekit_public_key" class="form-control font-monospace" value="<%= settings.imagekit_public_key %>">
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">ImageKit Private API Key:</label>
                  <input type="password" name="imagekit_private_key" class="form-control font-monospace" value="<%= settings.imagekit_private_key %>">
                </div>
                <div class="col-md-12">
                  <label class="form-label fw-semibold small">ImageKit URL Endpoint:</label>
                  <input type="text" name="imagekit_url_endpoint" class="form-control font-monospace" value="<%= settings.imagekit_url_endpoint %>">
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Primary Medical Storage Mode:</label>
                  <select name="cloud_storage_mode" class="form-select">
                    <option value="imagekit_active" <%= settings.cloud_storage_mode === 'imagekit_active' ? 'selected' : '' %>>ImageKit Cloud Storage Active (Encrypted CDN)</option>
                    <option value="local_fallback" <%= settings.cloud_storage_mode === 'local_fallback' ? 'selected' : '' %>>Local Encrypted Storage Fallback</option>
                  </select>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                  <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" name="auto_contrast_enhancement" id="autoContrastSwitch" <%= settings.auto_contrast_enhancement ? 'checked' : '' %>>
                    <label class="form-check-label small fw-semibold" for="autoContrastSwitch">Auto-contrast & deskew for physician handwritten Rx</label>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- TAB 4: Kiosk Voice & Multilingual Settings -->
          <div class="tab-pane fade" id="kiosk-pane" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white mb-4 border-start border-warning border-4">
              <h5 class="fw-bold text-warning-emphasis mb-3"><i class="bi bi-mic-fill me-2"></i>Kiosk Audio Prompts & Pan-India Regional Languages</h5>
              
              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Audio Prompts Speech Rate (0.75 = Elderly Gentle, 1.0 = Normal):</label>
                  <input type="number" step="0.05" name="speech_rate" class="form-control" value="<%= settings.speech_rate %>" min="0.5" max="1.5">
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Hardware Inactivity Auto-Reset Timeout (Seconds):</label>
                  <input type="number" name="inactivity_timeout_sec" class="form-control" value="<%= settings.inactivity_timeout_sec %>">
                </div>
              </div>

              <label class="form-label fw-semibold small text-uppercase mb-2">Enabled Regional Languages on Kiosk Touchscreen:</label>
              <div class="row g-2">
                <% 
                  const allLangs = [
                    { code: 'en', name: 'English (Indian)' },
                    { code: 'hi', name: 'हिन्दी (Hindi)' },
                    { code: 'bn', name: 'বাংলা (Bengali)' },
                    { code: 'ta', name: 'தமிழ் (Tamil)' },
                    { code: 'te', name: 'తెలుగు (Telugu)' },
                    { code: 'mr', name: 'मराठी (Marathi)' },
                    { code: 'gu', name: 'ગુજરાતી (Gujarati)' },
                    { code: 'kn', name: 'ಕನ್ನಡ (Kannada)' },
                    { code: 'ml', name: 'മലയാളം (Malayalam)' },
                    { code: 'or', name: 'ଓଡ଼ିଆ (Odia)' },
                    { code: 'pa', name: 'ਪੰਜਾਬੀ (Punjabi)' },
                    { code: 'as', name: 'অসমীয়া (Assamese)' }
                  ];
                %>
                <% allLangs.forEach(l => { %>
                  <div class="col-sm-4 col-md-3">
                    <div class="form-check p-2 bg-light rounded border">
                      <input class="form-check-input ms-0 me-2" type="checkbox" name="enabled_languages" value="<%= l.code %>" id="lang_<%= l.code %>" <%= (settings.enabled_languages || []).includes(l.code) ? 'checked' : '' %>>
                      <label class="form-check-label small fw-semibold" for="lang_<%= l.code %>"><%= l.name %></label>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>

          <!-- TAB 5: ABDM & DPDP Compliance -->
          <div class="tab-pane fade" id="compliance-pane" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white mb-4 border-start border-success border-4">
              <h5 class="fw-bold text-success mb-3"><i class="bi bi-shield-check me-2"></i>Ayushman Bharat Digital Mission (ABDM) & DPDP Act 2023</h5>
              
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">ABDM Gateway Operation Mode:</label>
                  <select name="abdm_mode" class="form-select">
                    <option value="sandbox" <%= settings.abdm_mode === 'sandbox' ? 'selected' : '' %>>National Sandbox (Testing & Validation)</option>
                    <option value="production" <%= settings.abdm_mode === 'production' ? 'selected' : '' %>>National Production ABDM Grid</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Data Protection Officer (DPO) Official Email:</label>
                  <input type="email" name="dpo_email" class="form-control" value="<%= settings.dpo_email %>">
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Audit Log Statutory Retention Period (Days):</label>
                  <input type="number" name="audit_retention_days" class="form-control" value="<%= settings.audit_retention_days %>">
                </div>
                <div class="col-md-6 d-flex align-items-end">
                  <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" name="mask_aadhaar_always" id="aadhaarMaskSwitch" <%= settings.mask_aadhaar_always ? 'checked' : '' %>>
                    <label class="form-check-label small fw-semibold" for="aadhaarMaskSwitch">Always mask Aadhaar to last 4 digits (UIDAI DPDP Standard)</label>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- Master Save Bar -->
        <div class="card shadow-sm border-0 rounded-4 p-3 bg-light d-flex flex-row justify-content-between align-items-center">
          <span class="text-muted small">
            <i class="bi bi-info-circle me-1"></i> Changes apply immediately to all Kiosks, Reception Desks, and Doctor Pads.
          </span>
          <button type="submit" class="btn btn-primary touch-btn-lg px-4 py-2 fw-bold shadow rounded-pill">
            <i class="bi bi-floppy-fill me-1"></i> Save & Apply Configuration Changes
          </button>
        </div>

      </form>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
