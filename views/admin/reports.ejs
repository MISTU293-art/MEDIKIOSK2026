<%- include('../partials/header') %>
<div class="app-layout-wrapper">
  <%- include('../partials/sidebar') %>
  <div class="main-content-wrapper">
    <%- include('../partials/topbar') %>
    <main class="p-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
          <h2 class="fw-bold m-0"><i class="bi bi-bar-chart-line text-primary me-2"></i>Executive Healthcare Analytics & Reports</h2>
          <p class="text-muted m-0">OPD Throughput, Departmental Intake Breakdown & SIH Prototype Metrics (PRD §25)</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/admin/export-intakes" class="btn btn-success shadow-sm rounded-pill px-4 fw-bold">
            <i class="bi bi-download me-1"></i> Export Full Dataset (CSV)
          </a>
        </div>
      </div>

      <div class="row g-4 mb-4">
        <div class="col-lg-4">
          <div class="card shadow-sm border-0 rounded-4 p-4 bg-white h-100">
            <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-pie-chart-fill me-2"></i>AYUSH Department Breakdown</h5>
            <ul class="list-group list-group-flush small">
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span>Ayurveda & Panchakarma</span>
                <span class="badge bg-primary rounded-pill">54%</span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span>Homoeopathy Medicine</span>
                <span class="badge bg-info text-dark rounded-pill">22%</span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span>Yoga & Naturopathy</span>
                <span class="badge bg-success rounded-pill">14%</span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span>Unani & Siddha</span>
                <span class="badge bg-secondary rounded-pill">10%</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="col-lg-8">
          <div class="card shadow-sm border-0 rounded-4 p-4 bg-white h-100">
            <h5 class="fw-bold mb-3 text-success"><i class="bi bi-lightning-charge-fill me-2"></i>OPD Intake Efficiency & Time Savings</h5>
            <div class="row g-3 text-center">
              <div class="col-sm-4">
                <div class="p-3 bg-light rounded-3 border">
                  <div class="text-muted small">Traditional Intake Time</div>
                  <div class="fs-4 fw-bold text-danger">12 - 15 mins</div>
                </div>
              </div>
              <div class="col-sm-4">
                <div class="p-3 bg-light rounded-3 border">
                  <div class="text-muted small">MediKiosk Kiosk Time</div>
                  <div class="fs-4 fw-bold text-success">3.8 mins</div>
                </div>
              </div>
              <div class="col-sm-4">
                <div class="p-3 bg-light rounded-3 border">
                  <div class="text-muted small">Clinician Time Saved</div>
                  <div class="fs-4 fw-bold text-primary">~70% / Patient</div>
                </div>
              </div>
            </div>
            <div class="alert alert-info mt-3 mb-0 small">
              <i class="bi bi-info-circle-fill me-1"></i> AI pre-structuring allows doctors to focus on examination and holistic counseling without administrative delay.
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>