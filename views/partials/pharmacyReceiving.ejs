<div class="card shadow-sm border-0 rounded-4 p-4 mb-4 bg-white">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h5 class="fw-bold m-0"><i class="bi bi-truck text-primary me-2"></i>Receive Stock Delivery</h5><span class="badge bg-light text-dark border">Receiver is recorded automatically</span></div>
  <form id="receiveStockForm" class="row g-2">
    <div class="col-md-4"><input name="name" class="form-control" placeholder="Medicine name *" required></div><div class="col-md-3"><input name="batchNumber" class="form-control" placeholder="Batch number *" required></div><div class="col-6 col-md-2"><input name="quantity" type="number" min="1" class="form-control" placeholder="Quantity *" required></div><div class="col-6 col-md-3"><input name="supplier" class="form-control" placeholder="Supplier"></div>
    <div class="col-md-3"><input name="invoiceNumber" class="form-control" placeholder="Invoice number"></div><div class="col-md-3"><input name="vehicleNumber" class="form-control" placeholder="Truck / vehicle number"></div><div class="col-md-3"><input name="deliveryPerson" class="form-control" placeholder="Delivery person"></div><div class="col-md-3"><input name="expiryDate" type="date" class="form-control"></div>
    <div class="col-md-3"><input name="unitPrice" type="number" min="0" step="0.01" class="form-control" placeholder="Unit price"></div><div class="col-md-7"><input name="notes" class="form-control" placeholder="Receiving notes"></div><div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Receive</button></div><div id="receiveStockFeedback" class="col-12" role="alert"></div>
  </form>
  <% if (receipts && receipts.length) { %><div class="table-responsive mt-3"><table class="table table-gov small"><thead><tr><th>Medicine</th><th>Supplier / Invoice</th><th>Truck</th><th>Qty</th><th>Received</th></tr></thead><tbody><% receipts.slice(0, 10).forEach(receipt => { %><tr><td><%= receipt.medicineName %><div class="text-muted"><%= receipt.batchNumber %></div></td><td><%= receipt.supplier || 'Not recorded' %><div class="text-muted"><%= receipt.invoiceNumber || 'No invoice' %></div></td><td><%= receipt.vehicleNumber || 'Not recorded' %></td><td><%= receipt.quantity %></td><td><%= new Date(receipt.receivedAt).toLocaleString() %></td></tr><% }) %></tbody></table></div><% } %>
</div>
<script>document.getElementById('receiveStockForm').addEventListener('submit', async event => { event.preventDefault(); const form=event.currentTarget; if(!form.checkValidity()){form.classList.add('was-validated');return;} const response=await fetch('/pharmacy/inventory/receive',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(form)))}); const data=await response.json(); const feedback=document.getElementById('receiveStockFeedback'); feedback.className=data.success?'alert alert-success':'alert alert-danger'; feedback.textContent=data.success?'Stock receipt saved and inventory updated.':data.error; if(data.success)setTimeout(()=>location.reload(),500); });</script>
