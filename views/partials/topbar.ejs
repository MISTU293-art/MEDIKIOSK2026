<!-- =========================================================
     MEDIKIOSK — PREMIUM HOSPITAL SAAS TOPBAR
========================================================= -->

<!-- Government / AYUSH Inspired Tricolor -->

<div class="gov-tricolor-bar"></div>

<header class="medikiosk-topbar">

<!-- ================= LEFT SECTION ================= -->
<div class="topbar-left">

    <!-- Mobile Sidebar Toggle -->
    <button
        class="sidebar-toggle d-md-none"
        type="button"
        onclick="toggleSidebar()"
        aria-label="Toggle Sidebar">

        <i class="bi bi-list"></i>
    </button>

    <!-- Brand -->
    <a href="/" class="brand-area text-decoration-none">

        <div class="brand-icon">
            <i class="bi bi-hospital"></i>
        </div>

        <div class="brand-content">

            <div class="brand-title">
                <%= typeof title !== 'undefined'
                    ? title.split('—')[0]
                    : 'MediKiosk AYUSH' %>
            </div>

            <div class="brand-subtitle d-none d-lg-flex">
                <i class="bi bi-geo-alt-fill"></i>
                National Institute of Ayurveda & AYUSH Research
            </div>

        </div>

    </a>

</div>


<!-- ================= CENTER SEARCH ================= -->

<div class="topbar-search d-none d-lg-flex">

    <form action="/pharmacy/lookup" method="GET">

        <div class="search-box">

            <i class="bi bi-search search-icon"></i>

            <input
                type="text"
                name="search"
                placeholder="Search Token, UHID or Mobile..."
                autocomplete="off">

            <kbd class="search-shortcut">⌕</kbd>

        </div>

    </form>

</div>


<!-- ================= RIGHT SECTION ================= -->

<div class="topbar-right">

    <!-- System Status -->

    <div class="system-status d-none d-xxl-flex">

        <div class="status-item cloud-status">

            <span class="status-dot"></span>

            <div>
                <strong>Cloud</strong>
                <small>Synced</small>
            </div>

        </div>


        <div class="status-divider"></div>


        <div class="status-item ai-status">

            <i class="bi bi-stars"></i>

            <div>
                <strong>MedLLM</strong>
                <small>AI Active</small>
            </div>

        </div>

    </div>


    <!-- Portal Switcher -->

    



  

    


    <!-- Patient Kiosk Button -->

    <a
        href="/kiosk"
        target="_blank"
        class="kiosk-launch-btn">

        <i class="bi bi-display"></i>

        <span class="d-none d-sm-inline">
            Patient Kiosk
        </span>

    </a>

</div>

</header>

<% if (typeof user !== 'undefined' && user && ['doctor', 'admin', 'staff', 'pharmacist'].includes(user.role)) { %>
<button id="clinicalAssistantToggle" class="btn btn-primary rounded-circle shadow position-fixed" style="right:18px;bottom:18px;width:56px;height:56px;z-index:1060" aria-label="Open clinical AI assistant"><i class="bi bi-robot fs-5"></i></button>
<section id="clinicalAssistantPanel" class="card shadow-lg border-0 position-fixed d-none" style="right:18px;bottom:84px;width:min(380px,calc(100vw - 36px));z-index:1060"><div class="card-header bg-primary text-white d-flex justify-content-between"><strong><i class="bi bi-stars me-1"></i>Clinical AI Assistant</strong><button id="clinicalAssistantClose" type="button" class="btn btn-sm text-white" aria-label="Close assistant"><i class="bi bi-x-lg"></i></button></div><div id="clinicalAssistantMessages" class="card-body small" style="max-height:250px;overflow-y:auto"><p class="mb-0">Ask about the current workflow, AI draft review, reports, prescriptions, or patient safety. Clinical decisions remain with you.</p></div><form id="clinicalAssistantForm" class="card-footer d-flex gap-2"><input id="clinicalAssistantInput" class="form-control" placeholder="Ask the clinical assistant" required><button class="btn btn-primary" type="submit" aria-label="Send question"><i class="bi bi-send"></i></button></form></section>
<script>(function(){const panel=document.getElementById('clinicalAssistantPanel');const add=(text,kind)=>{const item=document.createElement('p');item.className='border-top pt-2 mt-2 mb-0 '+(kind||'');item.textContent=text;document.getElementById('clinicalAssistantMessages').appendChild(item);item.scrollIntoView({block:'nearest'});};document.getElementById('clinicalAssistantToggle').addEventListener('click',()=>panel.classList.toggle('d-none'));document.getElementById('clinicalAssistantClose').addEventListener('click',()=>panel.classList.add('d-none'));document.getElementById('clinicalAssistantForm').addEventListener('submit',async event=>{event.preventDefault();const input=document.getElementById('clinicalAssistantInput');const message=input.value.trim();if(!message)return;add('You: '+message,'text-muted');input.value='';add('Thinking...','text-muted');try{const response=await fetch('/doctor/assistant',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message,mode:'doctor'})});const data=await response.json();const thinking=document.getElementById('clinicalAssistantMessages').lastElementChild;thinking.remove();add(data.success?data.message:(data.error||'The assistant could not respond.'),data.success?'':'text-danger');}catch(error){document.getElementById('clinicalAssistantMessages').lastElementChild?.remove();add('Assistant unavailable. Check the connection and try again.','text-danger');}});})();</script>
<% } %>

<!-- =========================================================
     STYLES
========================================================= -->

<style>

/* ===============================
   TRICOLOR BAR
================================ */

.gov-tricolor-bar {

    height: 4px;

    background:
        linear-gradient(
            90deg,
            #ff9933 0%,
            #ff9933 33.33%,
            #ffffff 33.33%,
            #ffffff 66.66%,
            #138808 66.66%,
            #138808 100%
        );

}


/* ===============================
   MAIN TOPBAR
================================ */

.medikiosk-topbar {

    min-height: 72px;

    padding: 0 24px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 24px;

    background: #ffffff;

    border-bottom: 1px solid #e9ecef;

    position: sticky;

    top: 0;

    z-index: 1030;

    box-shadow:
        0 2px 12px rgba(0, 0, 0, 0.04);

}


/* ===============================
   LEFT
================================ */

.topbar-left {

    display: flex;

    align-items: center;

    min-width: 260px;

}


.brand-area {

    display: flex;

    align-items: center;

    gap: 12px;

    color: inherit;

}


.brand-icon {

    width: 42px;

    height: 42px;

    border-radius: 12px;

    display: flex;

    align-items: center;

    justify-content: center;

    color: white;

    background:
        linear-gradient(
            135deg,
            #0d6efd,
            #0a58ca
        );

    font-size: 20px;

    box-shadow:
        0 6px 16px
        rgba(13, 110, 253, 0.22);

}


.brand-content {

    display: flex;

    flex-direction: column;

}


.brand-title {

    font-size: 16px;

    font-weight: 700;

    color: #1f2937;

    line-height: 1.2;

}


.brand-subtitle {

    margin-top: 3px;

    align-items: center;

    gap: 5px;

    font-size: 11px;

    color: #6b7280;

}


.brand-subtitle i {

    color: #dc3545;

}


/* ===============================
   MOBILE SIDEBAR BUTTON
================================ */

.sidebar-toggle {

    width: 40px;

    height: 40px;

    margin-right: 10px;

    border-radius: 10px;

    border: 1px solid #dee2e6;

    background: white;

    font-size: 20px;

}


/* ===============================
   SEARCH
================================ */

.topbar-search {

    flex: 1;

    max-width: 460px;

}


.topbar-search form {

    width: 100%;

}


.search-box {

    height: 42px;

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 0 12px;

    border-radius: 12px;

    background: #f8fafc;

    border: 1px solid #e5e7eb;

    transition: all 0.2s ease;

}


.search-box:focus-within {

    background: white;

    border-color: #0d6efd;

    box-shadow:
        0 0 0 4px
        rgba(13, 110, 253, 0.08);

}


.search-icon {

    color: #6b7280;

}


.search-box input {

    width: 100%;

    border: none;

    outline: none;

    background: transparent;

    font-size: 13px;

    color: #374151;

}


.search-box input::placeholder {

    color: #9ca3af;

}


.search-shortcut {

    padding: 2px 6px;

    border-radius: 5px;

    background: white;

    border: 1px solid #e5e7eb;

    font-size: 10px;

    color: #9ca3af;

}


/* ===============================
   RIGHT
================================ */

.topbar-right {

    display: flex;

    align-items: center;

    gap: 10px;

}


/* ===============================
   SYSTEM STATUS
================================ */

.system-status {

    display: flex;

    align-items: center;

    padding: 6px 10px;

    border-radius: 12px;

    background: #f8fafc;

    border: 1px solid #e9ecef;

}


.status-item {

    display: flex;

    align-items: center;

    gap: 7px;

}


.status-item strong {

    display: block;

    font-size: 11px;

    line-height: 1.1;

}


.status-item small {

    display: block;

    font-size: 10px;

    color: #6b7280;

}


.status-dot {

    width: 8px;

    height: 8px;

    border-radius: 50%;

    background: #198754;

    box-shadow:
        0 0 0 4px
        rgba(25, 135, 84, 0.12);

}


.ai-status i {

    font-size: 18px;

    color: #6f42c1;

}


.status-divider {

    width: 1px;

    height: 30px;

    margin: 0 12px;

    background: #dee2e6;

}


/* ===============================
   PORTAL SWITCH BUTTON
================================ */

.portal-switch-btn {

    height: 40px;

    padding: 0 14px;

    display: flex;

    align-items: center;

    gap: 7px;

    border-radius: 10px;

    border: 1px solid #dbeafe;

    background: white;

    color: #0d6efd;

    font-size: 13px;

    font-weight: 600;

    transition: all 0.2s ease;

}


.portal-switch-btn:hover {

    background: #eff6ff;

    border-color: #0d6efd;

}


/* ===============================
   PORTAL MENU
================================ */

.portal-menu {

    width: 330px;

    padding: 10px;

    margin-top: 10px;

    border: none;

    border-radius: 16px;

    box-shadow:
        0 20px 50px
        rgba(0, 0, 0, 0.14);

}


.portal-menu-header {

    padding: 10px 12px 14px;

}


.portal-menu-header span {

    display: block;

    font-size: 13px;

    font-weight: 700;

    color: #1f2937;

}


.portal-menu-header small {

    font-size: 11px;

    color: #9ca3af;

}


.portal-item {

    padding: 10px;

    display: flex;

    align-items: center;

    gap: 12px;

    border-radius: 12px;

    color: #374151;

    text-decoration: none;

    transition: all 0.18s ease;

}


.portal-item:hover {

    background: #f8fafc;

    transform: translateX(2px);

}


.portal-icon {

    width: 42px;

    height: 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 11px;

    font-size: 18px;

}


.portal-icon.doctor {

    background: #e7f1ff;

    color: #0d6efd;

}


.portal-icon.staff {

    background: #e0f7fa;

    color: #0dcaf0;

}


.portal-icon.pharmacy {

    background: #e8f7ee;

    color: #198754;

}


.portal-icon.admin {

    background: #fdeaea;

    color: #dc3545;

}


.portal-icon.kiosk {

    background: #fff3cd;

    color: #d39e00;

}


.portal-info {

    flex: 1;

}


.portal-info strong {

    display: block;

    font-size: 13px;

}


.portal-info small {

    display: block;

    margin-top: 2px;

    font-size: 11px;

    color: #6b7280;

}


.portal-arrow {

    color: #adb5bd;

    font-size: 13px;

}


.portal-divider {

    margin: 8px 5px;

    border-color: #e9ecef;

}


/* ===============================
   KIOSK BUTTON
================================ */

.kiosk-launch-btn {

    height: 40px;

    padding: 0 16px;

    display: flex;

    align-items: center;

    gap: 7px;

    border-radius: 10px;

    background:
        linear-gradient(
            135deg,
            #0d6efd,
            #0a58ca
        );

    color: white;

    text-decoration: none;

    font-size: 13px;

    transition: all 0.2s ease;

    box-shadow:
        0 6px 15px
        rgba(13, 110, 253, 0.22);

}


.kiosk-launch-btn:hover {

    color: white;

    transform: translateY(-1px);

    box-shadow:
        0 10px 22px
        rgba(13, 110, 253, 0.3);

}


/* ===============================
   RESPONSIVE
================================ */

@media (max-width: 992px) {

    .medikiosk-topbar {

        padding: 0 16px;

        min-height: 64px;

    }

    .topbar-left {

        min-width: auto;

    }

}


@media (max-width: 576px) {

    .brand-icon {

        width: 38px;

        height: 38px;

        font-size: 18px;

    }


    .brand-title {

        font-size: 14px;

    }


    .portal-menu {

        width: min(330px, calc(100vw - 20px));

    }


    .portal-switch-btn {

        width: 40px;

        justify-content: center;

        padding: 0;

    }


    .kiosk-launch-btn {

        width: 40px;

        justify-content: center;

        padding: 0;

    }

}

</style>

<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

function toggleSidebar() {

    const sidebar =
        document.getElementById("sidebarMenu");

    if (sidebar) {

        sidebar.classList.toggle("show");

    }

}


function setFontSize(size) {

    document.body.classList.remove(
        "font-large",
        "font-xlarge"
    );

    if (size === "large") {

        document.body.classList.add(
            "font-large"
        );

    }

    if (size === "xlarge") {

        document.body.classList.add(
            "font-xlarge"
        );

    }

}


function toggleContrast() {

    document.body.classList.toggle(
        "high-contrast"
    );

}

</script>
