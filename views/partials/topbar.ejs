<div>
  <!-- Official Tricolor Ribbon -->
  <div class="gov-tricolor-bar" style="height: 4px;"></div>

  <!-- Main SaaS Topbar -->
  <header class="topbar bg-white px-4 py-2 d-flex justify-content-between align-items-center shadow-sm border-bottom">
    
    <!-- Left: Facility & Breadcrumb -->
    <div class="d-flex align-items-center gap-3">
      <button class="btn btn-light btn-sm d-md-none rounded-circle border" type="button" onclick="toggleSidebar()">
        <i class="bi bi-list fs-5"></i>
      </button>
      <div class="d-flex align-items-center gap-2">
        <span class="fw-bold text-dark fs-6"><i class="bi bi-hospital text-primary me-1"></i> <%= typeof title !== 'undefined' ? title.split('—')[0] : 'MediKiosk AYUSH' %></span>
        <span class="badge bg-light text-secondary border small d-none d-lg-inline-block">
          <i class="bi bi-geo-alt-fill text-danger me-1"></i> National Institute of Ayurveda & AYUSH Research
        </span>
      </div>
    </div>

    <!-- Center: Global Search Bar -->
    <div class="d-none d-md-flex align-items-center" style="max-width: 300px; width: 100%;">
      <form action="/pharmacy/lookup" method="GET" class="w-100">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Search Token / UHID / Mobile...">
        </div>
      </form>
    </div>

    <!-- Right: SaaS Role Switcher & Live Status -->
    <div class="d-flex align-items-center gap-2">
      <!-- Live Cloud Indicators -->
      <span class="badge bg-success-subtle text-success border border-success px-2 py-1 small d-none d-xl-inline-block" style="font-size: 0.72rem;">
        <i class="bi bi-broadcast me-1"></i> ABDM Cloud: Synced
      </span>
      <span class="badge bg-purple-subtle text-purple border border-purple px-2 py-1 small d-none d-xl-inline-block" style="font-size: 0.72rem;">
        <i class="bi bi-lightning-charge-fill me-1"></i> MedLLM AI Active
      </span>

      <!-- SaaS Role Quick Switcher Dropdown -->
      <div class="dropdown">
        <button class="btn btn-outline-primary btn-sm rounded-pill dropdown-toggle fw-semibold px-3" type="button" data-bs-toggle="dropdown">
          <i class="bi bi-arrow-left-right me-1"></i> Switch Portal
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-2 small">
          <li><h6 class="dropdown-header text-uppercase text-muted" style="font-size: 0.7rem;">Active Hospital Portals:</h6></li>
          <li>
            <a class="dropdown-item rounded-3 d-flex align-items-center gap-2 py-2" href="/doctor/queue">
              <i class="bi bi-stethoscope text-primary fs-5"></i>
              <div><strong>Doctor Consultation</strong><div class="text-muted" style="font-size: 0.7rem;">OPD Queue & AI Copilot</div></div>
            </a>
          </li>
          <li>
            <a class="dropdown-item rounded-3 d-flex align-items-center gap-2 py-2" href="/staff/dashboard">
              <i class="bi bi-person-lines-fill text-info fs-5"></i>
              <div><strong>Reception & Triage Desk</strong><div class="text-muted" style="font-size: 0.7rem;">Fast Check-in & OCR Verification</div></div>
            </a>
          </li>
          <li>
            <a class="dropdown-item rounded-3 d-flex align-items-center gap-2 py-2" href="/pharmacy">
              <i class="bi bi-capsule text-success fs-5"></i>
              <div><strong>Medicine Shop & Pharmacy</strong><div class="text-muted" style="font-size: 0.7rem;">AI Drug Shield & POS Billing</div></div>
            </a>
          </li>
          <li>
            <a class="dropdown-item rounded-3 d-flex align-items-center gap-2 py-2" href="/admin/dashboard">
              <i class="bi bi-speedometer2 text-danger fs-5"></i>
              <div><strong>Superadmin Command Center</strong><div class="text-muted" style="font-size: 0.7rem;">Executive Analytics & Master Settings</div></div>
            </a>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <a class="dropdown-item rounded-3 d-flex align-items-center gap-2 py-2 text-warning-emphasis" href="/kiosk" target="_blank">
              <i class="bi bi-display fs-5 text-warning"></i>
              <div><strong>Citizen Touchscreen Kiosk</strong><div class="text-muted" style="font-size: 0.7rem;">Patient Self-Service Mode</div></div>
            </a>
          </li>
        </ul>
      </div>

      <!-- Kiosk Launch Button -->
      <a href="/kiosk" target="_blank" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm">
        <i class="bi bi-display me-1"></i> Patient Kiosk
      </a>
    </div>
  </header>
</div>

<script>
function setFontSize(size) {
  document.body.classList.remove('font-large', 'font-xlarge');
  if (size === 'large') document.body.classList.add('font-large');
  if (size === 'xlarge') document.body.classList.add('font-xlarge');
}
function toggleContrast() {
  document.body.classList.toggle('high-contrast');
}
function toggleSidebar() {
  document.getElementById('sidebarMenu').classList.toggle('show');
}
</script>
