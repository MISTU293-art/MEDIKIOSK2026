<%- include('../partials/header') %><div class="app-layout-wrapper"><%- include('../partials/sidebar') %><div class="main-content-wrapper"><%- include('../partials/topbar') %><main class="p-4"><div class="mx-auto" style="max-width:560px"><div class="card border-0 shadow-sm p-4"><h2 class="fw-bold">Staff Attendance</h2><p class="text-muted">Scan the QR on your staff card or enter its opaque ID. The server decides clock in or clock out.</p><div class="mb-3"><video id="attendanceCamera" class="w-100 rounded border d-none" autoplay muted playsinline style="max-height:240px;object-fit:cover"></video><button id="cameraButton" class="btn btn-outline-primary w-100" type="button"><i class="bi bi-camera me-1"></i> Scan QR with camera</button><div id="cameraStatus" class="form-text"></div></div><form id="attendanceForm"><label class="form-label">Staff card ID</label><input id="cardIdInput" name="cardId" class="form-control form-control-lg mb-3" autocomplete="off" placeholder="SC-..." required><input type="hidden" name="terminalId" value="web-attendance-terminal"><button class="btn btn-primary btn-lg w-100" type="submit">Record attendance</button></form><div id="attendanceResult" class="mt-3" role="status"></div></div></div></main></div></div><script>
const attendanceForm=document.getElementById('attendanceForm');const result=document.getElementById('attendanceResult');
attendanceForm.addEventListener('submit',async event=>{event.preventDefault();if(!attendanceForm.checkValidity()){attendanceForm.classList.add('was-validated');return;}const button=attendanceForm.querySelector('button[type="submit"]');button.disabled=true;result.className='alert alert-info mt-3';result.textContent='Recording attendance...';try{const response=await fetch('/attendance/scan',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(attendanceForm)))});const data=await response.json();result.className=data.success?'alert alert-success mt-3':'alert alert-danger mt-3';result.textContent=data.success?`${data.staff.name}: clocked ${data.action} at ${new Date(data.timestamp).toLocaleTimeString()}`:data.error;}catch(error){result.className='alert alert-danger mt-3';result.textContent='Attendance service unavailable. Please try again or contact the supervisor.';}finally{button.disabled=false;}});
const camera=document.getElementById('attendanceCamera');const cameraButton=document.getElementById('cameraButton');const cameraStatus=document.getElementById('cameraStatus');let stream;cameraButton.addEventListener('click',async()=>{if(!('BarcodeDetector' in window)){cameraStatus.textContent='Camera QR scanning is not supported in this browser. Enter the card ID manually.';document.getElementById('cardIdInput').focus();return;}try{stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'environment'}}});camera.srcObject=stream;camera.classList.remove('d-none');cameraButton.disabled=true;cameraStatus.textContent='Point the camera at the staff QR code.';const detector=new BarcodeDetector({formats:['qr_code']});const scan=async()=>{if(camera.classList.contains('d-none'))return;const codes=await detector.detect(camera);if(codes.length){document.getElementById('cardIdInput').value=codes[0].rawValue;stream.getTracks().forEach(track=>track.stop());camera.classList.add('d-none');cameraButton.disabled=false;cameraStatus.textContent='QR captured. Submit to record attendance.';attendanceForm.requestSubmit();}else requestAnimationFrame(scan);};scan();}catch(error){cameraStatus.textContent='Camera permission was unavailable. Enter the card ID manually.';}});
</script><%- include('../partials/footer') %>