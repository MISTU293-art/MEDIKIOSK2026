# ==============================================================================
# MediKiosk AYUSH — Smart India Hackathon (SIH) Government Prototype
# Environment Configuration Template (.env.example)
# ==============================================================================

# Server & Network Configuration
PORT=3000
NODE_ENV=development
HOSPITAL_NAME=National Institute of Ayurveda & AYUSH Research Hospital
HFR_FACILITY_ID=IN-DL-AYUSH-HOSP-0042
STATE=Delhi (National Capital Territory)
DISTRICT=Central Delhi

# Database Configuration
# MongoDB connection URI (e.g. local instance or MongoDB Atlas cluster)
# If MongoDB is unavailable, the platform automatically fails over to in-memory store.
MONGODB_URI=mongodb://127.0.0.1:27017/medikiosk

# Authentication & JWT Security Secrets
JWT_ACCESS_SECRET=medikiosk_access_jwt_super_secret_key_2026
JWT_REFRESH_SECRET=medikiosk_refresh_jwt_super_secret_key_2026
ACCESS_TOKEN_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# Google Gemini / MedLLM AI Gateway
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_PROVIDER=gemini-1.5-flash
AI_TEMPERATURE=0.2

# ImageKit.io Cloud Storage & Medical OCR CDN
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ABDM & Data Protection Compliance
DPO_EMAIL=dpo@hospital.org
ENABLE_AUDIT_LOGS=true
ENABLE_RED_FLAG_SAFETY_NET=true
